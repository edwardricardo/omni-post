# ────────────────────────────────────────────────────────────────────────
# Backend env template (API + workers). Mirror of the Zod schema in
# `apps/api/src/config/env.ts`. Copy to `.env` and fill in real values.
#
# Markers:
#   (required)        — the API refuses to boot without this.
#   (default: X)      — schema applies X if unset.
#   (optional)        — undefined is fine; feature gracefully disables.
#   (conditional: X)  — required when X is configured (e.g. PAYMENT_PROVIDER=stripe).
#
# Reference: docs/architecture/secrets-and-env.md
# ────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development                            # (default: development) — one of: development | production | test | staging
PORT=3000                                       # (default: 3000)
HOST=0.0.0.0                                    # (default: 0.0.0.0)

# ── Database (PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DBNAME>?schema=public"            # (required)
SHADOW_DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:5432/<SHADOWDBNAME>?schema=public"  # (required for prisma migrate)
# Pool tuning — defaults: prod = max(CPU*2, 10), dev = min(CPU+2, 8).
# Override DB_POOL_SIZE only when running on small (CPU<2) or oversized boxes.
DB_POOL_SIZE=                                   # (optional, integer)
# Time the pg client waits to acquire a connection before giving up.
# 10 s matches the Prisma canon; raise only behind very high-latency LBs.
DB_CONNECTION_TIMEOUT=10000                     # (optional, ms — default: 10000)
# Idle connection lifetime before pg recycles. Kept below the typical 10 min
# cloud LB idle cutoff so the LB never closes connections out from under us.
DB_IDLE_TIMEOUT=580000                          # (optional, ms — default: 580000)

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"              # (optional, preferred over host/port/password trio)
REDIS_HOST=                                     # (optional)
REDIS_PORT=                                     # (optional)
REDIS_PASSWORD=                                 # (optional)
REDIS_POOL_SIZE=10                              # (optional)

# ── Auth secrets — REQUIRED, fail-fast at boot if missing or < 32 chars ─
# Generate via: openssl rand -hex 64
JWT_ACCESS_SECRET=<CHANGE_ME_64_HEX_BYTES>      # (required)
JWT_REFRESH_SECRET=<CHANGE_ME_64_HEX_BYTES>     # (required)
CUSTOMER_JWT_SECRET=<CHANGE_ME_64_HEX_BYTES>    # (required)
ADMIN_JWT_ACCESS_SECRET=<CHANGE_ME_64_HEX_BYTES>  # (required)
ADMIN_JWT_REFRESH_SECRET=<CHANGE_ME_64_HEX_BYTES> # (required)
COOKIE_SECRET=<CHANGE_ME_64_HEX_BYTES>          # (required)

# ── Cryptography — REQUIRED ─────────────────────────────────────────────
# Generate via: openssl rand -base64 32 (PLATFORM) / openssl rand -hex 32 (OAUTH expects hex)
PLATFORM_ENCRYPTION_KEY=<CHANGE_ME_BASE64_32>   # (required) — for credential encryption (AES-GCM)
OAUTH_ENCRYPTION_KEY=<CHANGE_ME_HEX_64>         # (required) — for OAuth token-at-rest encryption

# ── URLs (frontends + base) ─────────────────────────────────────────────
ADMIN_URL=http://localhost:3100                 # (optional)
CLIENT_URL=http://localhost:3200                # (optional)
CLIENT_APP_URL=                                 # (optional)
FRONTEND_URL=                                   # (optional)
APP_BASE_URL=http://localhost:3000              # (optional)
API_BASE_URL=http://localhost:3000              # (optional)
ALLOWED_MEDIA_HOSTS=                            # (optional, comma-separated allowlist for media sources)

# ── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=info                                  # (default: info) — fatal|error|warn|info|debug|trace|silent
LOG_CACHE_OPS=                                  # (optional, true/false) — log every cache get/set

# ── Telemetry ───────────────────────────────────────────────────────────
TRACING_ENABLED=false                           # (default: false) — OpenTelemetry export
METRICS_PORT=9090                               # (optional, used by workers' Prometheus listener)

# ── Cache ───────────────────────────────────────────────────────────────
MATERIALIZED_VIEW_REFRESH_INTERVAL=900          # (optional, seconds)

# ── Storage ─────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local                          # (default: local) — local | s3
S3_BUCKET=                                      # (conditional: STORAGE_PROVIDER=s3)
S3_REGION=                                      # (conditional: STORAGE_PROVIDER=s3)
S3_ACCESS_KEY_ID=                               # (conditional: STORAGE_PROVIDER=s3)
S3_SECRET_ACCESS_KEY=                           # (conditional: STORAGE_PROVIDER=s3)

# ── Payment ─────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=none                           # (default: none) — stripe | paddle | none
STRIPE_SECRET_KEY=                              # (conditional: PAYMENT_PROVIDER=stripe)
STRIPE_WEBHOOK_SECRET=                          # (conditional: PAYMENT_PROVIDER=stripe)
PADDLE_API_KEY=                                 # (conditional: PAYMENT_PROVIDER=paddle)
PADDLE_WEBHOOK_SECRET=                          # (conditional: PAYMENT_PROVIDER=paddle)
PADDLE_SANDBOX=                                 # (optional, true/false)

# ── AI providers ────────────────────────────────────────────────────────
OPENAI_API_KEY=                                 # (optional, AI features auto-disable without it)
OPENAI_MODEL=                                   # (optional, default: gpt-4 if AI enabled)
PERPLEXITY_API_KEY=                             # (optional)
PERPLEXITY_MODEL=                               # (optional)
GEMINI_API_KEY=                                 # (optional)
GEMINI_MODEL=                                   # (optional)

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=                                 # (optional)
RESEND_FROM_ADDRESS=                            # (optional)

# ── Analytics (GA4) ─────────────────────────────────────────────────────
GA4_MEASUREMENT_ID=                             # (optional)
GA4_API_SECRET=                                 # (optional)
GA4_ENDPOINT=                                   # (optional)

# ── Provider OAuth (one trio per platform: CLIENT_ID + CLIENT_SECRET + REDIRECT_URI) ──
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REDIRECT_URI=

# ── CRM ─────────────────────────────────────────────────────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_REDIRECT_URI=
SALESFORCE_CLIENT_ID=
SALESFORCE_REDIRECT_URI=
SALESFORCE_SANDBOX=

# ── System tools ────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg                              # (default: ffmpeg)
FFPROBE_PATH=ffprobe                            # (default: ffprobe)
THUMBNAIL_TEMP_DIR=/tmp/claude/thumbnails       # (default)
VIDEO_TEMP_DIR=/tmp/claude/video                # (default)

# ── Feature flags ───────────────────────────────────────────────────────
ENABLE_RATE_LIMITING=true                       # (default: true)

# ── Bcrypt rounds ───────────────────────────────────────────────────────
BCRYPT_ROUNDS=10                                # (optional)

# ── Admin seed (dev only — replace via launch runbook) ──────────────────
ADMIN_EMAIL=admin@omnipost.local
ADMIN_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ────────────────────────────────────────────────────────────────────────
# Docker Compose service credentials (read by docker-compose.yml).
# These are NOT loaded by the API/workers; they parametrize the local
# Postgres/MinIO/Grafana containers.
# ────────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
POSTGRES_DB=omnipostdb
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
