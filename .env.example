# OmniPost — Root .env.example
#
# Template de variables de entorno. Copiar a `.env` y completar con valores reales.
# Este archivo NO contiene valores reales — solo placeholders y formatos esperados.
#
# Regla de seguridad: `.env` está gitignored (ver .gitignore:31). NUNCA commitear `.env`.
# Ver `docs/security/T0A_SECRETS_ROTATION_RUNBOOK.md` para rotación de secrets.
#
# Organizado por sección. Cada var marcada como (required) es obligatoria para arrancar;
# el resto son opcionales con defaults sensatos en código.

# ============================================================================
# Node / process
# ============================================================================

# "development" | "production" | "test"
NODE_ENV=development

# ============================================================================
# Database (PostgreSQL)
# ============================================================================

# (required) Conexión principal a PostgreSQL
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DBNAME>?schema=public"

# (required for prisma migrate) Shadow DB — usada por Prisma para generar migrations.
# Requiere permisos CREATE DB en el usuario de PostgreSQL.
SHADOW_DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<SHADOW_DBNAME>?schema=public"

# (optional) Replica URLs, CSV — lectura distribuida
DATABASE_REPLICA_URLS=""

# (optional) Pool de conexiones. Defaults en client.ts si se omite.
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=30000
DATABASE_IDLE_TIMEOUT=60000
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=60000
DB_TIMEOUT=30000

# (optional) Refresh interval (ms) para vistas materializadas
MATERIALIZED_VIEW_REFRESH_INTERVAL=300000

# ============================================================================
# Redis (cache + queues BullMQ)
# ============================================================================

# (required) URL completa. Fallback a REDIS_HOST + REDIS_PORT si no se usa.
REDIS_URL="redis://<HOST>:<PORT>"

# (optional) Alternativa al REDIS_URL
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=5000

# (optional) Queue job timeout (ms)
QUEUE_TIMEOUT=60000

# ============================================================================
# API server (Fastify) — puertos y URLs
# ============================================================================

# (optional) Puerto del API server. Default 3000.
PORT=3000
HOST=0.0.0.0

# (required) URL base del API server — usada en webhooks OAuth callbacks, emails
API_URL="http://localhost:3000"
API_BASE_URL="http://localhost:3000"
BASE_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# (required) URLs de las apps frontend
ADMIN_URL="http://localhost:3100"
CLIENT_URL="http://localhost:3200"
CLIENT_APP_URL="http://localhost:3200"
FRONTEND_URL="http://localhost:3200"

# (required en admin) Password default del primer admin seed. Cambiar en prod.
ADMIN_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ============================================================================
# Next.js — variables públicas (expuestas al browser)
# ============================================================================

# (required en ambos frontends)
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_URL="http://localhost:3200"

# (optional) Sentry DSN del frontend. Generar en sentry.io.
NEXT_PUBLIC_SENTRY_DSN=

# ============================================================================
# Auth — JWT secrets (admin API + customer API)
# ============================================================================

# (required) Generar con: openssl rand -hex 64
JWT_SECRET=<CHANGE_ME_64_HEX_BYTES>
JWT_REFRESH_SECRET=<CHANGE_ME_64_HEX_BYTES>

# (required) Secrets específicos por rol. Diferentes de JWT_SECRET.
ADMIN_JWT_ACCESS_SECRET=<CHANGE_ME_64_HEX_BYTES>
CUSTOMER_JWT_SECRET=<CHANGE_ME_64_HEX_BYTES>

# ============================================================================
# Auth — encryption keys (OAuth tokens + platform credentials)
# ============================================================================

# (required) AES-256 keys para cifrar tokens OAuth + credenciales de providers.
# Generar con: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=<CHANGE_ME_32_HEX_BYTES>
PLATFORM_ENCRYPTION_KEY=<CHANGE_ME_32_HEX_BYTES>

# ============================================================================
# Storage (S3-compatible — MinIO en dev, S3/R2 en prod)
# ============================================================================

# (required) "s3" | "minio" | "r2"
STORAGE_PROVIDER=minio

AWS_REGION=us-east-1
AWS_S3_BUCKET=omni-post-media
AWS_ACCESS_KEY_ID=<ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
# (optional, solo MinIO) endpoint custom
AWS_ENDPOINT="http://localhost:9000"

# Alternativas con prefijo S3_* (legacy — leer primero AWS_*)
S3_BUCKET=omni-post-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>

# (optional) URL pública para media servida desde S3 (CloudFront / R2 public URL)
MEDIA_STORAGE_URL=

# (optional) CSV de hostnames permitidos para fetch de media externa
ALLOWED_MEDIA_HOSTS=""

# ============================================================================
# Media processing (ffmpeg + thumbnails)
# ============================================================================

# (optional) Paths custom a binarios. Defaults: del PATH del sistema.
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
VIDEO_TEMP_DIR=/tmp/omnipost-video
THUMBNAIL_TEMP_DIR=/tmp/omnipost-thumbnails

# ============================================================================
# Billing / payment providers
# ============================================================================

# (required) "stripe" | "paddle"
PAYMENT_PROVIDER=stripe

# Stripe
STRIPE_SECRET_KEY=<sk_test_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>

# Paddle
PADDLE_API_KEY=<pdl_...>
PADDLE_WEBHOOK_SECRET=<whsec_...>
PADDLE_SANDBOX=true

# ============================================================================
# AI providers
# ============================================================================

# OpenAI (imagen + chat)
OPENAI_API_KEY=<sk-...>
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=<AIza...>
GEMINI_MODEL=gemini-1.5-pro

# Perplexity (research / trends)
PERPLEXITY_API_KEY=<pplx-...>
PERPLEXITY_MODEL=llama-3.1-sonar-large-128k-online

# (optional) Fallback / generic API key
PROVIDER_API_KEY=

# ============================================================================
# Social providers — X (Twitter)
# ============================================================================

X_CLIENT_ID=
X_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_REDIRECT_URI="http://localhost:3000/api/auth/oauth/x/callback"

# ============================================================================
# Social providers — Meta (Facebook + Instagram)
# ============================================================================

# Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_LONG_LIVED_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_AD_ACCOUNT_ID=
FACEBOOK_INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/auth/oauth/facebook/callback"

# Instagram (Graph API)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/auth/oauth/instagram/callback"

# ============================================================================
# Social providers — LinkedIn
# ============================================================================

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/auth/oauth/linkedin/callback"

# ============================================================================
# Social providers — YouTube
# ============================================================================

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/auth/oauth/youtube/callback"

# ============================================================================
# Social providers — TikTok (content + ads + research)
# ============================================================================

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_ADVERTISER_ID=
TIKTOK_ANALYTICS_API_KEY=
TIKTOK_RESEARCH_API_KEY=
TIKTOK_REDIRECT_URI="http://localhost:3000/api/auth/oauth/tiktok/callback"

# ============================================================================
# Social providers — Pinterest
# ============================================================================

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_BOARD_ID=
PINTEREST_REDIRECT_URI="http://localhost:3000/api/auth/oauth/pinterest/callback"

# ============================================================================
# Social providers — Snapchat (ads)
# ============================================================================

SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_ACCESS_TOKEN=
SNAPCHAT_REFRESH_TOKEN=
SNAPCHAT_ORGANIZATION_ID=
SNAPCHAT_REDIRECT_URI="http://localhost:3000/api/auth/oauth/snapchat/callback"

# ============================================================================
# Social providers — Telegram
# ============================================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================================
# Social providers — Bluesky (AT Protocol)
# ============================================================================

BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# ============================================================================
# Social providers — Threads (Meta)
# ============================================================================

THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ============================================================================
# CRM integrations (HubSpot + Salesforce)
# ============================================================================

HUBSPOT_CLIENT_ID=
HUBSPOT_REDIRECT_URI="http://localhost:3000/api/auth/oauth/hubspot/callback"

SALESFORCE_CLIENT_ID=
SALESFORCE_SANDBOX=true
SALESFORCE_REDIRECT_URI="http://localhost:3000/api/auth/oauth/salesforce/callback"

# ============================================================================
# Analytics — Google Analytics 4
# ============================================================================

GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GA4_ENDPOINT="https://www.google-analytics.com/mp/collect"

# ============================================================================
# Email (Resend)
# ============================================================================

RESEND_API_KEY=<re_...>
RESEND_FROM_ADDRESS="no-reply@omnipost.dev"

# ============================================================================
# Observability — Sentry, OpenTelemetry, Prometheus
# ============================================================================

# (optional) Sentry DSN del backend
SENTRY_DSN=

# OpenTelemetry
OTEL_SERVICE_NAME=omnipost-api
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
TRACING_ENABLED=true

# Prometheus
PROMETHEUS_PORT=9464
METRICS_PORT=9100

# ============================================================================
# Logging
# ============================================================================

# "fatal" | "error" | "warn" | "info" | "debug" | "trace"
LOG_LEVEL=info
LOG_CACHE_OPS=false

# ============================================================================
# Feature flags
# ============================================================================

ENABLE_RATE_LIMITING=true

# ============================================================================
# Testing / development tools (only set in test / CI environments)
# ============================================================================

# Playwright
PLAYWRIGHT_BASE_URL="http://localhost:3200"

# Integration tests — bypass mocks when true
USE_REAL_ADAPTERS=false
USE_REAL_PROVIDERS=false

# Coverage / mutation testing
COVERAGE_MODE=false
TEST_TIMEOUT=30000
RATE_LIMIT_TEST_MODE=false

# ============================================================================
# Docker Compose service credentials (consumed by docker-compose.yml)
# ============================================================================
# These are interpolated by docker-compose at startup. Without them, the
# docker-compose.yml will fail with "POSTGRES_PASSWORD must be set in .env"
# (single source of truth for dev credentials).

# (required) PostgreSQL container init credentials. Match DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
POSTGRES_DB=omnipostdb

# (required) MinIO root credentials. Generate strong passwords; minio-init
# entrypoint reads these to create the omni-post-media bucket.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# (required) Grafana admin login (http://localhost:3001).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
