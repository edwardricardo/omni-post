# OmniPost — Root .env.example
#
# Template de variables de entorno. Copiar a `.env` y completar con valores reales.
# Este archivo NO contiene valores reales — solo placeholders y formatos esperados.
#
# Regla de seguridad: `.env` está gitignored (ver .gitignore:31). NUNCA commitear `.env`.
# Ver `docs/security/T0A_SECRETS_ROTATION_RUNBOOK.md` para rotación de secrets.

# ============================================================================
# Database (PostgreSQL)
# ============================================================================

# Conexión principal a PostgreSQL
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DBNAME>?schema=public"

# Shadow DB — usada por Prisma para generar migrations (requiere permisos CREATE DB)
SHADOW_DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<SHADOW_DBNAME>?schema=public"

# Pool de conexiones (opcional, defaults en client.ts)
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=60000

# Refresh de vistas materializadas en ms
MATERIALIZED_VIEW_REFRESH_INTERVAL=300000

# ============================================================================
# Redis (cache + queues BullMQ)
# ============================================================================

REDIS_URL="redis://<HOST>:<PORT>"
REDIS_POOL_SIZE=10

# ============================================================================
# API (Fastify)
# ============================================================================

PORT=3000
NODE_ENV=development

# TTL de cache por default en ms (ver L-377 cache-redis TTL hardcoded)
CACHE_TTL=300000

# ============================================================================
# Auth — JWT (overlap con apps/api/.env — L-586 double SoT pendiente consolidar)
# ============================================================================

# Generar con: openssl rand -hex 64
JWT_ACCESS_SECRET=<CHANGE_ME_64_HEX_BYTES>
JWT_REFRESH_SECRET=<CHANGE_ME_64_HEX_BYTES>

# ============================================================================
# Platform Encryption (credenciales de providers sociales)
# ============================================================================

# Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ NO rotar sin data migration — encripta PlatformCredential rows existentes.
# Ver runbook §3.
PLATFORM_ENCRYPTION_KEY=<CHANGE_ME_BASE64_32_BYTES>

# ============================================================================
# Observability / OpenTelemetry
# ============================================================================

TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=omnipost-api
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# ============================================================================
# Metrics / Performance
# ============================================================================

METRICS_ENABLED=true
PERFORMANCE_MONITORING=true
