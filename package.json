{
  "name": "omni-post",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "packageManager": "pnpm@10.16.0+sha512.8066e7b034217b700a9a4dbb3a005061d641ba130a89915213a10b3ca4919c19c037bec8066afdc559b89635fdb806b16ea673f2468fbb28aabfa13c53e3f769",
  "scripts": {
    "test": "turbo run test --filter='[HEAD^1]' --concurrency=4",
    "test:all": "turbo run test --concurrency=4",
    "test:branch": "turbo run test --affected --concurrency=4",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix --max-warnings 0",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "typecheck": "turbo run typecheck",
    "generate:api-types": "tsx scripts/generate-api-types.ts",
    "typecheck:apps": "pnpm --filter @apps/api --filter @apps/admin --filter @apps/client --filter @apps/workers typecheck",
    "build": "turbo run build",
    "dev:api": "pnpm --filter @apps/api dev",
    "dev:workers": "pnpm --filter @apps/workers dev",
    "dev:admin": "pnpm --filter @apps/admin dev",
    "dev:client": "pnpm --filter @apps/client dev",
    "dev:all": "concurrently -n api,workers,admin,client -c green,cyan,yellow,blue \"pnpm dev:api\" \"pnpm dev:workers\" \"pnpm dev:admin\" \"pnpm dev:client\"",
    "dev": "concurrently -n api,workers -c green,cyan \"pnpm dev:api\" \"pnpm dev:workers\"",
    "db:up": "bash scripts/db-up.sh",
    "db:studio": "pnpm --filter @infra/prisma studio",
    "db:migrate": "pnpm --filter @infra/prisma migrate",
    "db:seed": "pnpm --filter @infra/prisma seed",
    "prepare": "husky",
    "perf:test": "bash performance/scripts/run-performance-tests.sh",
    "perf:load": "k6 run performance/k6/scenarios/load-test.js",
    "perf:stress": "k6 run performance/k6/scenarios/stress-test.js",
    "perf:endurance": "k6 run performance/k6/scenarios/endurance-test.js",
    "perf:api": "k6 run performance/k6/scenarios/api-performance.js",
    "perf:db": "tsx performance/database/postgres-stress.test.ts",
    "perf:memory": "tsx performance/monitoring/memory-leak-detector.ts",
    "perf:baseline": "tsx performance/scripts/baseline-capture.ts",
    "perf:regression": "tsx performance/monitoring/regression-detector.ts",
    "perf:report": "tsx performance/scripts/generate-reports.ts",
    "quality:check": "bash quality/scripts/run-quality-checks.sh",
    "quality:setup": "bash quality/scripts/setup-environment.sh",
    "quality:dashboard": "open quality/dashboards/quality-dashboard.html",
    "quality:bundle": "tsx quality/scripts/bundle-analyzer.ts",
    "quality:security": "pnpm audit --audit-level moderate && npx license-checker",
    "quality:full": "pnpm quality:check && pnpm quality:bundle",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "check:dead-code": "node scripts/knip-ratchet.mjs",
    "check:duplicates": "jscpd apps/ packages/",
    "check:circular": "madge --circular --extensions ts,tsx --exclude 'generated|node_modules|dist' apps/api/src/ packages/",
    "secret:scan": "secretlint --secretlintrc .secretlintrc.json --secretlintignore .secretlintignore 'apps/**/*' 'packages/**/*' 'infra/**/*' '.env*' '*.{ts,tsx,js,jsx,json,md,yml,yaml,toml,sh}'",
    "env:backup": "bash scripts/env-backup.sh",
    "env:restore": "bash scripts/env-restore.sh"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.42.0",
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.36.0",
    "@hey-api/client-fetch": "0.13.1",
    "@hey-api/openapi-ts": "0.97.3",
    "@secretlint/secretlint-rule-preset-recommend": "12.3.1",
    "@size-limit/preset-small-lib": "12.1.0",
    "@stryker-mutator/core": "9.6.0",
    "@stryker-mutator/vitest-runner": "9.6.0",
    "@types/opossum": "8.1.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "autocannon": "8.0.0",
    "concurrently": "9.2.1",
    "depcheck": "1.4.7",
    "dependency-cruiser": "17.4.0",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "6.0.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "fastify-type-provider-zod": "6.1.0",
    "husky": "9.1.7",
    "jiti": "2.6.1",
    "jq": "1.7.2",
    "jscpd": "4.0.8",
    "knip": "6.12.2",
    "license-checker": "25.0.1",
    "lint-staged": "16.4.0",
    "loadtest": "8.2.1",
    "madge": "8.0.0",
    "msw": "2.14.3",
    "prettier": "3.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "secretlint": "12.3.1",
    "size-limit": "12.1.0",
    "tsx": "4.22.4",
    "turbo": "2.9.16",
    "typescript": "5.9.3",
    "zod": "4.3.6"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "zod": "4.3.6",
      "pino": "10.3.1",
      "shell-quote": "1.8.4",
      "esbuild": "0.28.1",
      "form-data": "4.0.5",
      "fast-xml-parser": "5.7.0",
      "xmlhttprequest-ssl": "4.0.0",
      "typescript": "5.9.3",
      "@anthropic-ai/sdk": "0.91.1",
      "@babel/plugin-transform-modules-systemjs": "7.29.4",
      "@hono/node-server": "1.19.13",
      "@opentelemetry/auto-instrumentations-node": "0.75.0",
      "@opentelemetry/exporter-prometheus": "0.217.0",
      "@opentelemetry/sdk-node": "0.217.0",
      "@protobufjs/utf8": "1.1.1",
      "@smithy/config-resolver": "4.4.0",
      "@tootallnate/once": "3.0.1",
      "@xmldom/xmldom": "0.8.13",
      "axios": "1.17.0",
      "bn.js": "5.2.3",
      "brace-expansion": "2.0.3",
      "cloudinary": "2.7.0",
      "defu": "6.1.5",
      "diff": "4.0.4",
      "dompurify": "3.4.0",
      "fast-uri": "3.1.2",
      "fast-xml-builder": "1.1.7",
      "fastify": "5.8.5",
      "flatted": "3.4.2",
      "follow-redirects": "1.16.0",
      "handlebars": "4.7.9",
      "hono": "4.12.23",
      "icu-minify": "4.9.2",
      "jws": "4.0.1",
      "lodash": "4.18.0",
      "markdown-it": "14.1.1",
      "minimatch": "7.4.8",
      "msw>path-to-regexp": "6.3.0",
      "next": "16.2.6",
      "next-intl": "4.9.2",
      "path-to-regexp": "8.4.0",
      "postcss": "8.5.10",
      "protobufjs": "7.5.9",
      "qs": "6.15.2",
      "vitest": "4.1.8",
      "ws": "8.21.0",
      "rollup": "4.59.0",
      "serialize-javascript": "7.0.5",
      "tough-cookie": "4.1.3",
      "uuid": "13.0.1",
      "validator": "13.15.22",
      "vite": "7.3.2",
      "xmlhttprequest": "1.7.0"
    },
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/engines",
      "@prisma/client",
      "esbuild"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-p8p7-x288-28g6",
        "GHSA-848j-6mx2-7j84",
        "GHSA-q7cg-457f-vx79"
      ]
    },
    "patchedDependencies": {
      "@secretlint/node@12.3.1": "patches/@secretlint__node@12.3.1.patch"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ],
    "*": [
      "secretlint --secretlintrc .secretlintrc.json --secretlintignore .secretlintignore"
    ]
  },
  "size-limit": [
    {
      "name": "admin · all client chunks (aggregate)",
      "path": "apps/admin/.next/static/chunks/*.js",
      "limit": "1.35 MB",
      "gzip": true
    },
    {
      "name": "client · all client chunks (aggregate)",
      "path": "apps/client/.next/static/chunks/*.js",
      "limit": "1.75 MB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@t3-oss/env-core": "0.13.11",
    "@t3-oss/env-nextjs": "0.13.11"
  }
}
