{
  "name": "omni-post",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "scripts": {
    "test": "turbo run test --filter='[HEAD^1]' --concurrency=4",
    "test:all": "turbo run test --concurrency=4",
    "test:branch": "turbo run test --affected --concurrency=4",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix --max-warnings 0",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "typecheck": "turbo run typecheck",
    "generate:api-types": "tsx scripts/generate-api-types.ts",
    "typecheck:apps": "pnpm --filter @apps/api --filter @apps/admin --filter @apps/client --filter @apps/workers typecheck",
    "build": "turbo run build",
    "dev:api": "pnpm --filter @apps/api dev",
    "dev:workers": "pnpm --filter @apps/workers dev",
    "dev:admin": "pnpm --filter @apps/admin dev",
    "dev:client": "pnpm --filter @apps/client dev",
    "dev:all": "turbo run dev --filter=@apps/api --filter=@apps/workers --filter=@apps/admin --filter=@apps/client",
    "dev": "turbo run dev --filter=@apps/api --filter=@apps/workers",
    "db:up": "bash scripts/db-up.sh",
    "db:studio": "pnpm --filter @infra/prisma studio",
    "db:migrate": "pnpm --filter @infra/prisma migrate",
    "db:seed": "pnpm --filter @infra/prisma seed",
    "prepare": "husky",
    "perf:test": "bash performance/scripts/run-performance-tests.sh",
    "perf:load": "k6 run performance/k6/scenarios/load-test.js",
    "perf:stress": "k6 run performance/k6/scenarios/stress-test.js",
    "perf:endurance": "k6 run performance/k6/scenarios/endurance-test.js",
    "perf:api": "k6 run performance/k6/scenarios/api-performance.js",
    "perf:db": "tsx performance/database/postgres-stress.test.ts",
    "perf:memory": "tsx performance/monitoring/memory-leak-detector.ts",
    "perf:baseline": "tsx performance/scripts/baseline-capture.ts",
    "perf:regression": "tsx performance/monitoring/regression-detector.ts",
    "perf:report": "tsx performance/scripts/generate-reports.ts",
    "quality:check": "bash quality/scripts/run-quality-checks.sh",
    "quality:setup": "bash quality/scripts/setup-environment.sh",
    "quality:dashboard": "open quality/dashboards/quality-dashboard.html",
    "quality:bundle": "tsx quality/scripts/bundle-analyzer.ts",
    "quality:security": "pnpm audit --audit-level moderate && npx license-checker",
    "quality:full": "pnpm quality:check && pnpm quality:bundle",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "check:dead-code": "node scripts/knip-ratchet.mjs",
    "check:duplicates": "jscpd apps/ packages/",
    "check:circular": "madge --circular --extensions ts,tsx --exclude 'generated|node_modules|dist' apps/api/src/ packages/",
    "secret:scan": "secretlint --secretlintrc .secretlintrc.json --secretlintignore .secretlintignore 'apps/**/*' 'packages/**/*' 'infra/**/*' '.env*' '*.{ts,tsx,js,jsx,json,md,yml,yaml,toml,sh}'",
    "env:backup": "bash scripts/env-backup.sh",
    "env:restore": "bash scripts/env-restore.sh"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.42.0",
    "@axe-core/playwright": "catalog:",
    "@eslint/js": "9.36.0",
    "@hey-api/client-fetch": "0.13.1",
    "@hey-api/openapi-ts": "0.97.3",
    "@secretlint/secretlint-rule-preset-recommend": "12.3.1",
    "@size-limit/preset-small-lib": "12.1.0",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/opossum": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "autocannon": "8.0.0",
    "depcheck": "1.4.7",
    "dependency-cruiser": "17.4.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fastify-type-provider-zod": "catalog:",
    "husky": "9.1.7",
    "jiti": "2.6.1",
    "jq": "1.7.2",
    "jscpd": "4.0.8",
    "knip": "6.12.2",
    "license-checker": "25.0.1",
    "lint-staged": "16.4.0",
    "loadtest": "8.2.1",
    "madge": "8.0.0",
    "msw": "catalog:",
    "prettier": "3.9.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "secretlint": "12.3.1",
    "size-limit": "12.1.0",
    "tsx": "catalog:",
    "turbo": "2.9.16",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ],
    "*.{mjs,cjs}": [
      "prettier --write"
    ],
    "*": [
      "secretlint --secretlintrc .secretlintrc.json --secretlintignore .secretlintignore"
    ]
  },
  "size-limit": [
    {
      "name": "admin · all client chunks (aggregate)",
      "path": "apps/admin/.next/static/chunks/*.js",
      "limit": "1.35 MB",
      "gzip": true
    },
    {
      "name": "client · all client chunks (aggregate)",
      "path": "apps/client/.next/static/chunks/*.js",
      "limit": "1.75 MB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@t3-oss/env-core": "catalog:",
    "@t3-oss/env-nextjs": "catalog:"
  }
}
