# Hoist stryker packages to workspace root so all packages can run mutation tests
# without requiring per-package devDependency declarations.
public-hoist-pattern[]=@stryker-mutator/*

# Future `pnpm add` writes an exact spec instead of a caret range, backing the
# ADR-0018 "no ^ ~ * >=" rule at the tooling level before syncpack lints it.
save-prefix=""
