{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUncheckedSideEffectImports": false,
    "paths": {
      "@/*": ["./*"],
      "@shared/types": ["../../packages/shared/dist/index.d.ts"],
      "@shared/types/*": ["../../packages/shared/dist/*"],
      "@core/domain": ["../../packages/core/domain/src/index.ts"],
      "@core/domain/*": ["../../packages/core/domain/src/*"],
      "@core/application": ["../../packages/core/application/src/index.ts"],
      "@core/application/*": ["../../packages/core/application/src/*"],
      "@providers/instagram/*": ["../../packages/providers/instagram/*"],
      "@packages/api-errors": ["../../packages/api-errors/src/index.ts"],
      "@packages/ui": ["../../packages/ui/src/index.ts"],
      "@packages/ui/*": ["../../packages/ui/src/*"],
      "@core/bulk-scheduling/schedulingCsvSchema.js": [
        "../../packages/core/bulk-scheduling/src/schedulingCsvSchema.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "tests/**/*", "**/*.test.*", "**/__tests__/**/*", "vitest.config.ts"]
}
