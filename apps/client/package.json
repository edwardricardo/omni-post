{
  "name": "@apps/client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test --config=tests/e2e/config/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=tests/e2e/config/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config=tests/e2e/config/playwright.config.ts --headed",
    "typecheck": "tsc --noEmit",
    "test:e2e:debug": "playwright test --config=tests/e2e/config/playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report test-results/html-report",
    "test:e2e:auth": "playwright test --config=tests/e2e/config/playwright.config.ts tests/e2e/tests/auth.spec.ts",
    "test:e2e:publishing": "playwright test --config=tests/e2e/config/playwright.config.ts tests/e2e/tests/publishing.spec.ts",
    "test:e2e:analytics": "playwright test --config=tests/e2e/config/playwright.config.ts tests/e2e/tests/analytics.spec.ts",
    "test:e2e:mobile": "playwright test --config=tests/e2e/config/playwright.config.ts --project=mobile-chrome",
    "test:e2e:accessibility": "playwright test --config=tests/e2e/config/playwright.config.ts --project=accessibility",
    "test:e2e:visual": "playwright test --config=tests/e2e/config/playwright.config.ts --project=visual-regression",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:test": "test-storybook",
    "chromatic": "npx chromatic --project-token=<project-token>"
  },
  "dependencies": {
    "@monaco-editor/react": "4.6.0",
    "@packages/ui": "workspace:*",
    "@shared/types": "workspace:*",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-query-devtools": "5.90.2",
    "@tiptap/core": "3.6.1",
    "@tiptap/extension-character-count": "3.6.1",
    "@tiptap/extension-color": "3.6.1",
    "@tiptap/extension-highlight": "3.6.1",
    "@tiptap/extension-link": "3.6.1",
    "@tiptap/extension-placeholder": "3.6.1",
    "@tiptap/extension-text-style": "3.6.1",
    "@tiptap/extension-typography": "3.6.1",
    "@tiptap/pm": "3.6.1",
    "@tiptap/react": "3.6.1",
    "@tiptap/starter-kit": "3.6.1",
    "date-fns": "4.1.0",
    "fuse.js": "7.0.0",
    "lucide-react": "0.544.0",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-diff-viewer": "3.1.1",
    "react-dom": "19.2.4",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "@storybook/addon-a11y": "10.2.13",
    "@storybook/addon-docs": "10.2.13",
    "@storybook/nextjs": "10.2.13",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "24.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "4.0.18",
    "eslint": "9.36.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.6",
    "storybook": "10.2.13",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.2",
    "vitest": "4.0.18"
  }
}
