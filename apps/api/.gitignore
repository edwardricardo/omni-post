# Coverage reports
coverage/
.nyc_output/
*.lcov

# Test artifacts
test-results/
test-report.xml
junit.xml

# Temporary files
*.tmp
*.temp
.temp/

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Runtime files
*.pid
*.log

# Runtime output from local scripts lands here. The root .gitignore used to cover
# this directory with an unanchored `logs/`, but that rule also swallowed an App
# Router segment and is now anchored to the repo root (/logs/), so this package has
# to declare its own. `*.log` / `*.pid` above only catch those two extensions, and a
# generated file of any other would have no cover — hence the whole directory,
# anchored to the package root so no nested source dir can match it.
/logs/
