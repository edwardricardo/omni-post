# Test Environment Configuration
# Uses same database/Redis but with shorter timeouts and specific settings

# Database - Use same DB but with test schema
DATABASE_URL="postgresql://postgres:password123@localhost:5432/omnipostdb?schema=test"

# Redis - Same instance but with test key prefix
REDIS_URL="redis://localhost:6379"

# API Configuration
PORT=3001
NODE_ENV=test

# Test-specific timeouts (shorter for faster test execution)
TEST_TIMEOUT=10000
DB_TIMEOUT=5000
REDIS_TIMEOUT=3000
QUEUE_TIMEOUT=5000

# Disable some features during testing
DISABLE_RATE_LIMITING=true
DISABLE_CIRCUIT_BREAKER=true
LOG_LEVEL=warn