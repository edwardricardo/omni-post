{
  "reporter": ["text", "text-summary", "html", "lcov", "json"],
  "reports-dir": "./coverage",
  "temp-directory": "./coverage/.nyc_output",
  "clean": true,
  "all": true,
  "include": ["src/**/*.ts", "src/**/*.js"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "tests/**/*",
    "coverage/**/*",
    "src/**/*.d.ts",
    "src/types/**/*",
    "src/**/__tests__/**/*",
    "src/**/__mocks__/**/*"
  ],
  "check-coverage": true,
  "lines": 90,
  "functions": 90,
  "branches": 85,
  "statements": 90,
  "per-file": true,
  "skip-full": false,
  "watermarks": {
    "lines": [80, 95],
    "functions": [80, 95],
    "branches": [75, 90],
    "statements": [80, 95]
  },
  "exclude-after-remap": false
}
