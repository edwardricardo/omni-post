# OmniPost API — .env.example
#
# Template de variables de entorno para `apps/api`. Copiar a `apps/api/.env` y completar.
# Este archivo NO contiene valores reales — solo placeholders.
#
# Regla de seguridad: `apps/api/.env` está gitignored. NUNCA commitear `.env`.
# Ver `docs/security/T0A_SECRETS_ROTATION_RUNBOOK.md` para rotación de secrets.
#
# Nota: overlap con root `.env` (L-586 double SoT pendiente consolidar en T4 configs).

# ============================================================================
# Database (PostgreSQL)
# ============================================================================

DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DBNAME>"
SHADOW_DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<SHADOW_DBNAME>"

# ============================================================================
# Redis (cache + BullMQ queues)
# ============================================================================

REDIS_URL="redis://<HOST>:<PORT>"

# ============================================================================
# API Server
# ============================================================================

PORT=3000
NODE_ENV=development

# URLs públicas de las 3 apps (para links absolutos en emails, OAuth callbacks, etc.)
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3100
CLIENT_URL=http://localhost:3200

# ============================================================================
# Auth — JWT (generar cada uno con: openssl rand -hex 64)
# ============================================================================

ADMIN_JWT_SECRET=<CHANGE_ME_64_HEX_BYTES>
JWT_ACCESS_SECRET=<CHANGE_ME_64_HEX_BYTES>
JWT_REFRESH_SECRET=<CHANGE_ME_64_HEX_BYTES>

# Customer auth (separado de admin)
CUSTOMER_JWT_SECRET=<CHANGE_ME_64_HEX_BYTES>
CUSTOMER_JWT_EXPIRY=15m
CUSTOMER_REFRESH_EXPIRY=30d

# ============================================================================
# Admin bootstrap (seed user)
# ============================================================================

# ⚠️ L-546: fallback weak. Cambiar obligatorio en producción.
# Fail-fast si env missing será implementado en T4-V (RBAC + seeds split).
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# Bcrypt work factor (prod recomendado: 12)
BCRYPT_ROUNDS=12

# ============================================================================
# Storage
# ============================================================================

# Provider activo (s3 | do-spaces | azure | gcs) — ver T6-B 5a multi-cloud WIRE
STORAGE_PROVIDER=s3

# S3 / DigitalOcean Spaces (S3-compatible)
# AWS_ACCESS_KEY_ID=<CHANGE_ME>
# AWS_SECRET_ACCESS_KEY=<CHANGE_ME>
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=<BUCKET_NAME>
# AWS_S3_ENDPOINT=<S3_COMPATIBLE_ENDPOINT>   # solo si DO Spaces o MinIO

# Azure Blob Storage (T6-B 5a WIRE — pendiente wire)
# AZURE_STORAGE_ACCOUNT=<CHANGE_ME>
# AZURE_STORAGE_KEY=<CHANGE_ME>
# AZURE_STORAGE_CONTAINER=<CHANGE_ME>

# Google Cloud Storage (T6-B 5a WIRE — pendiente wire)
# GCS_PROJECT_ID=<CHANGE_ME>
# GCS_KEY_FILE_PATH=<PATH_TO_KEY_JSON>
# GCS_BUCKET=<CHANGE_ME>

# ============================================================================
# AI Providers
# ============================================================================

# OpenAI
OPENAI_API_KEY=<CHANGE_ME>
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

# Perplexity
PERPLEXITY_API_KEY=<CHANGE_ME>
PERPLEXITY_MODEL=llama-3.1-sonar-small-128k-online
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# Google Gemini
GEMINI_API_KEY=<CHANGE_ME>
GEMINI_MODEL=gemini-1.5-flash

# ============================================================================
# Email (Resend)
# ============================================================================

RESEND_API_KEY=<CHANGE_ME>
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME="OmniPost"

# ============================================================================
# Billing / Payment Gateway
# ============================================================================

# Provider activo (stripe | paddle)
PAYMENT_PROVIDER=stripe

# Stripe
STRIPE_SECRET_KEY=<CHANGE_ME>
STRIPE_WEBHOOK_SECRET=<CHANGE_ME>

# Paddle (fallback — ver gateway switching B.2)
# PADDLE_API_KEY=<CHANGE_ME>
# PADDLE_WEBHOOK_SECRET=<CHANGE_ME>

# ============================================================================
# Observability / OpenTelemetry
# ============================================================================

TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=omnipost-api

# ============================================================================
# Logging
# ============================================================================

LOG_LEVEL=info
LOG_FORMAT=json

# ============================================================================
# Feature Flags
# ============================================================================

ENABLE_AI_FEATURES=true
ENABLE_ANALYTICS=true
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
ENABLE_METRICS=true
METRICS_ENABLED=true

# ============================================================================
# CRM Integrations (T6-B 5b WIRE — pendiente wire)
# ============================================================================

# HubSpot
# HUBSPOT_CLIENT_ID=<CHANGE_ME>
# HUBSPOT_CLIENT_SECRET=<CHANGE_ME>
# HUBSPOT_REDIRECT_URI=http://localhost:3000/crm/hubspot/callback

# Salesforce
# SALESFORCE_CLIENT_ID=<CHANGE_ME>
# SALESFORCE_CLIENT_SECRET=<CHANGE_ME>
# SALESFORCE_REDIRECT_URI=http://localhost:3000/crm/salesforce/callback
# SALESFORCE_SANDBOX=false
