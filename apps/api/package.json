  },
  "devDependencies": {
    "@faker-js/faker": "10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@stryker-mutator/core": "8.2.6",
    "@stryker-mutator/typescript-checker": "8.2.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/qrcode": "1.5.5",
    "@types/validator": "13.15.3",
    "@types/ws": "8.18.1",
    "@types/xml2js": "0.4.14",
