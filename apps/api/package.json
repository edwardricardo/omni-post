{
  "name": "@apps/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file=../../.env --import tsx src/index.ts",
    "dev:test": "cross-env NODE_ENV=test tsx src/index.ts",
    "dump:openapi": "node --env-file=../../.env --import tsx scripts/dump-openapi-spec.ts",
    "test": "vitest run",
