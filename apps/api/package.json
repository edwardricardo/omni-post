    "@providers/tiktok": "workspace:*",
    "@providers/x": "workspace:*",
    "@providers/youtube": "workspace:*",
    "@shared/types": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "5.58.9",
    "dotenv": "17.2.2",
    "fastify": "5.6.1",
    "fastify-plugin": "5.0.1",
    "fastify-type-provider-zod": "6.1.0",
    "ioredis": "5.7.0",
    "isomorphic-dompurify": "2.28.0",
    "jsonwebtoken": "9.0.2",
    "openai": "5.22.0",
    "otplib": "12.0.1",
    "pino": "10.3.1",
