    "test:eval": "vitest run tests/eval",
    "test:all": "bash scripts/run-tests.sh",
    "test:integration": "bash scripts/run-tests.sh",
    "test:plan": "cross-env NODE_ENV=test node --import tsx --test --test-force-exit tests/planPublication.test.ts",
