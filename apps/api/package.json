{
  "name": "@apps/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file=../../.env --import tsx src/index.ts",
    "dev:test": "cross-env NODE_ENV=test tsx src/index.ts",
    "test": "bash scripts/run-tests.sh",
    "test:all-flat": "cross-env NODE_ENV=test node --import tsx --test --test-force-exit --test-timeout=30000 tests/**/*.test.ts",
    "test:main": "cross-env NODE_ENV=test node --import tsx --test tests/*.test.ts",
    "test:watch": "cross-env NODE_ENV=test node --import tsx --test --watch tests/**/*.test.ts",
    "test:coverage": "cross-env NODE_ENV=test c8 --reporter=text --reporter=html --reporter=lcov node --import tsx --test tests/**/*.test.ts",
    "test:coverage:watch": "cross-env NODE_ENV=test c8 --reporter=text node --import tsx --test --watch tests/**/*.test.ts",
    "test:coverage:check": "c8 check-coverage --lines 80 --functions 80 --branches 80",
    "test:coverage:report": "c8 report --reporter=html && open coverage/index.html",
    "test:all": "pnpm run test:coverage",
    "test:plan": "cross-env NODE_ENV=test node --import tsx --test tests/planPublication.test.ts",
    "test:adapters": "cross-env NODE_ENV=test node --import tsx --test tests/adapters.test.ts",
    "test:media": "cross-env NODE_ENV=test node --import tsx --test tests/media.flow.test.ts",
    "test:schedule": "cross-env NODE_ENV=test node --import tsx --test tests/schedule.flow.test.ts",
    "test:analytics": "cross-env NODE_ENV=test node --import tsx --test tests/analytics.flow.test.ts",
    "test:ratelimit": "cross-env NODE_ENV=test node --import tsx --test tests/rateLimit.smoke.test.ts",
    "test:threading-planner": "cross-env NODE_ENV=test node --import tsx --test tests/threading.planner.test.ts",
    "test:threading-xprovider": "cross-env NODE_ENV=test node --import tsx --test tests/threading.xprovider.test.ts",
    "test:threading-canonical": "cross-env NODE_ENV=test node --import tsx --test tests/threading.canonical.test.ts",
    "test:multiproject": "cross-env NODE_ENV=test node --import tsx --test tests/multiproject.flow.test.ts",
    "test:security": "cross-env NODE_ENV=test node --import tsx --test tests/security.test.ts",
    "test:auth": "cross-env NODE_ENV=test node --import tsx --test tests/auth.test.ts",
    "test:mfa": "cross-env NODE_ENV=test node --import tsx --test tests/mfa.test.ts",
    "test:rbac": "cross-env NODE_ENV=test node --import tsx --test tests/rbac.test.ts",
    "test:account-lifecycle": "cross-env NODE_ENV=test node --import tsx --test tests/accountLifecycle.test.ts",
    "test:trial-period": "cross-env NODE_ENV=test node --import tsx --test tests/trialPeriod.test.ts",
    "test:audit": "cross-env NODE_ENV=test node --import tsx --test tests/audit.test.ts",
    "test:schema-utils": "cross-env NODE_ENV=test node --import tsx --test tests/schemaUtils.test.ts",
    "test:provider-registry": "cross-env NODE_ENV=test node --import tsx --test tests/providerRegistry.test.ts",
    "test:phase4c-integration": "cross-env NODE_ENV=test node --import tsx --test tests/phase4c-integration.test.ts",
    "test:cache": "cross-env NODE_ENV=test node --import tsx --test tests/cache.test.ts",
    "test:analytics-ml": "cross-env NODE_ENV=test node --import tsx --test tests/analytics-ml-integration.test.ts",
    "test:production-integration": "cross-env NODE_ENV=test node --import tsx --test tests/production.integration.test.ts",
    "test:category:core": "cross-env NODE_ENV=test node --import tsx --test tests/planPublication.test.ts tests/adapters.test.ts tests/schemaUtils.test.ts tests/providerRegistry.test.ts",
    "test:category:security": "cross-env NODE_ENV=test node --import tsx --test tests/security.test.ts tests/auth.test.ts tests/mfa.test.ts tests/rbac.test.ts",
    "test:category:threading": "cross-env NODE_ENV=test node --import tsx --test tests/threading.planner.test.ts tests/threading.xprovider.test.ts tests/threading.canonical.test.ts",
    "test:category:account": "cross-env NODE_ENV=test node --import tsx --test tests/accountLifecycle.test.ts tests/trialPeriod.test.ts tests/audit.test.ts",
    "test:category:workflow": "cross-env NODE_ENV=test node --import tsx --test tests/media.flow.test.ts tests/schedule.flow.test.ts tests/analytics.flow.test.ts",
    "test:category:integration": "cross-env NODE_ENV=test node --import tsx --test tests/multiproject.flow.test.ts tests/phase4c-integration.test.ts tests/production.integration.test.ts tests/analytics-ml-integration.test.ts",
    "test:auth-security": "cross-env NODE_ENV=test node --import tsx --test-force-exit security/tests/auth-security.test.ts",
    "test:api-security": "cross-env NODE_ENV=test node --import tsx --test-force-exit security/tests/api-security.injection.test.ts security/tests/api-security.validation-auth.test.ts",
    "test:injection-security": "cross-env NODE_ENV=test node --import tsx --test-force-exit security/tests/injection-tests.sql-nosql.test.ts security/tests/injection-tests.xss-command.test.ts security/tests/injection-tests.ldap-xml-template-header.test.ts",
    "test:infrastructure-security": "cross-env NODE_ENV=test node --import tsx --test-force-exit security/tests/infrastructure-security.test.ts",
    "test:security-comprehensive": "cross-env NODE_ENV=test node --import tsx --test-force-exit security/tests/auth-security.test.ts security/tests/api-security.injection.test.ts security/tests/api-security.validation-auth.test.ts security/tests/injection-tests.sql-nosql.test.ts security/tests/injection-tests.xss-command.test.ts security/tests/injection-tests.ldap-xml-template-header.test.ts security/tests/infrastructure-security.test.ts",
    "security:scan": "bash security/scripts/security-scan.sh",
    "security:report": "tsx security/scripts/vulnerability-report.ts",
    "perf:postgres": "cross-env NODE_ENV=test tsx ../../performance/database/postgres-stress.test.ts",
    "perf:redis": "cross-env NODE_ENV=test tsx ../../performance/database/redis-performance.test.ts",
    "perf:memory": "cross-env NODE_ENV=test tsx ../../performance/monitoring/memory-leak-detector.ts",
    "perf:baseline": "cross-env NODE_ENV=test tsx ../../performance/scripts/baseline-capture.ts",
    "perf:regression": "cross-env NODE_ENV=test tsx ../../performance/monitoring/regression-detector.ts"
  },
  "dependencies": {
    "@adapters/cache-redis": "workspace:*",
    "@adapters/db-prisma": "workspace:*",
    "@adapters/dead-letter-queue": "workspace:*",
    "@adapters/queue-bullmq": "workspace:*",
    "@adapters/storage-s3": "workspace:*",
    "@core/engine": "workspace:*",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.1",
    "@fastify/websocket": "11.2.0",
    "@google/genai": "1.44.0",
    "@infra/prisma": "workspace:*",
