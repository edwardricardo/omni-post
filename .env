# Database
DATABASE_URL="postgresql://postgres:password123@localhost:5432/omnipostdb?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:password123@localhost:5432/omnipostdb_shadow?schema=public"


# Redis
