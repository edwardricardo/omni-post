# ─────────────────────────────────────────────────────────────────────────────
# .env.test.example — TRACKED template for the test environment.
#
# Copy to .env.test (gitignored) and fill DATABASE_URL / REDIS_URL with your
# local dockerised infra (typically pointing at the host name configured in
# scripts/dev-infra-up.sh — e.g. `omnipost-infra` on the homelab dev box,
# `localhost` for a laptop docker-compose). Everything else is a safe dummy
# meeting the Zod schema constraints in `apps/api/src/config/env.ts` —
# do NOT replace these with real secrets.
#
# CI does NOT use this file — `scripts/ci-setup-test-env.sh` synthesizes
# .env.test from shell-exported DATABASE_URL / REDIS_URL on every job run.
#
# See: docs/architecture/secrets-and-env.md §Test environment.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=test
PORT=3001
HOST=0.0.0.0

# ── Database (LOCAL DEV: edit to point at your infra) ────────────────────────
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/omnipostdb?schema=public
# SHADOW_DATABASE_URL=postgresql://postgres:<password>@<host>:5432/omnipostdb_shadow?schema=public
DATABASE_URL=postgresql://postgres:CHANGE_ME@omnipost-infra:5432/omnipostdb?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:CHANGE_ME@omnipost-infra:5432/omnipostdb_shadow?schema=public

# ── Redis (REQUIRED: apps/api fails to boot without REDIS_URL) ───────────────
# REDIS_URL=redis://:<password>@<host>:6379
REDIS_URL=redis://:CHANGE_ME@omnipost-infra:6379

# ── Secrets (DUMMY values — never real prod secrets in this file) ────────────
# All ≥32 chars per Zod schema. The HMAC-style values below are
# obviously-fake fixed strings; tests don't rely on entropy.
JWT_ACCESS_SECRET=test-jwt-access-secret-0000000000000000000000000000000000
JWT_REFRESH_SECRET=test-jwt-refresh-secret-0000000000000000000000000000000000
CUSTOMER_JWT_SECRET=test-customer-jwt-secret-0000000000000000000000000000000000
ADMIN_JWT_ACCESS_SECRET=test-admin-jwt-access-secret-0000000000000000000000000000
ADMIN_JWT_REFRESH_SECRET=test-admin-jwt-refresh-secret-0000000000000000000000000000
COOKIE_SECRET=test-cookie-secret-0000000000000000000000000000000000

# ── Encryption keys (MUST be base64 of EXACTLY 32 bytes — see EncryptionService) ──
# These are AAAA...= (base64 of 32 zero bytes) — safe dummies for tests.
PLATFORM_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
OAUTH_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Client-IP resolution: tests run without a trusted proxy -> socket-only (fail-closed)
TRUSTED_PROXY_HOP_COUNT=0
