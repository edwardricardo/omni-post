{
  "name": "@core/security",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@core/application": "workspace:*",
    "@core/domain": "workspace:*",
    "@ports/core": "workspace:*",
    "@shared/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "typescript": "6.0.2",
    "vitest": "4.0.18"
  }
}
