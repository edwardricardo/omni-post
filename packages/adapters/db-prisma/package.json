{
  "name": "@adapters/db-prisma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@core/domain": "workspace:*",
    "@infra/prisma": "workspace:*",
    "@observability/background-scheduler": "workspace:*",
    "@observability/logger": "workspace:*",
    "@ports/core": "workspace:*",
    "@prisma/client": "catalog:",
    "@shared/types": "workspace:*",
    "ioredis": "catalog:",
    "opossum": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
