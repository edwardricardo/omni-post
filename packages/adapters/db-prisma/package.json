{
  "name": "@adapters/db-prisma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": "./dist/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@core/domain": "workspace:*",
    "@infra/prisma": "workspace:*",
    "@observability/background-scheduler": "workspace:*",
    "@observability/logger": "workspace:*",
    "@ports/core": "workspace:*",
    "@prisma/client": "7.4.1",
    "@shared/types": "workspace:*",
    "ioredis": "5.7.0",
    "opossum": "9.0.0"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
