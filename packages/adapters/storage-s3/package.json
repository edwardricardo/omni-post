{
  "name": "@adapters/storage-s3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "dependencies": {
    "@adapters/external-apis": "workspace:*",
    "@aws-sdk/client-s3": "3.894.0",
    "@aws-sdk/s3-presigned-post": "3.894.0",
    "@aws-sdk/s3-request-presigner": "3.894.0",
    "@observability/logger": "workspace:*",
    "@ports/core": "workspace:*",
    "@shared/types": "workspace:*",
    "prom-client": "15.1.3"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "aws-sdk-client-mock": "4.1.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
