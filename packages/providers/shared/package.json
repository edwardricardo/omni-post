{
  "name": "@providers/shared",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-utils/msw-helpers": {
      "development": "./src/test-utils/msw-helpers.ts",
      "default": "./dist/test-utils/msw-helpers.js"
    }
  },
  "dependencies": {
    "@ports/core": "workspace:*",
    "@shared/types": "workspace:*",
