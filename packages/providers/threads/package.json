{
  "name": "@providers/threads",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@adapters/external-apis": "workspace:*",
    "@adapters/fallback-strategies": "workspace:*",
    "@observability/logger": "workspace:*",
    "@ports/core": "workspace:*",
    "@providers/shared": "workspace:*",
    "@shared/types": "workspace:*",
    "pino": "catalog:",
    "prom-client": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
