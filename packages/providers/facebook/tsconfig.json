{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@shared/types": ["../../shared/types/src"],
      "@shared/*": ["../../shared/src/*"],
      "@ports/core": ["../../ports/src"],
      "@providers/shared": ["../shared/src"],
      "@core/threading": ["../../core/threading/src"],
      "@adapters/external-apis": ["../../adapters/external-apis/src"],
      "@adapters/fallback-strategies": ["../../adapters/fallback-strategies/src"],
      "@adapters/db-prisma": ["../../adapters/db-prisma/src"]
    }
  },
  "include": [
    "src/index.ts",
    "src/apiClient.ts",
    "src/FacebookAdapter.ts",
    "src/FacebookProviderHelper.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/features/**/*",
    "src/media/**/*",
    "src/analytics/**/*"
  ]
}
