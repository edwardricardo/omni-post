{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "paths": {
      "@shared/types": ["../../shared/src"],
      "@shared/*": ["../../shared/src/*"],
      "@ports/core": ["../../ports/src"],
      "@adapters/external-apis": ["../../adapters/external-apis/src"],
      "@adapters/fallback-strategies": ["../../adapters/fallback-strategies/src"],
      "@providers/shared": ["../shared/src"],
      "@core/domain/*": ["../../core/domain/src/*"],
      "@core/application/*": ["../../core/application/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
