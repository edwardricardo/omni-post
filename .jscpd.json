{
  "minLines": 10,
  "minTokens": 50,
  "format": ["typescript", "tsx"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/reports/**",
    "**/.next/**",
    "**/generated/**",
    "**/api-generated/**",
    "**/*.generated.ts",
    "**/tests/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.tsx",
    "**/*.config.ts"
  ],
  "absolute": true,
  "baseline": ".jscpd-baseline.json",
  "failOnNewClones": 0,
  "failOnEmpty": true,
  "noTips": true
}
