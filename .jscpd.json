{
  "threshold": 4.84,
  "minLines": 10,
  "minTokens": 50,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/reports/**",
    "**/.next/**",
    "**/generated/**",
    "**/pnpm-lock.yaml",
    "**/tests/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.tsx",
    "**/*.config.ts"
  ],
  "format": ["typescript", "typescriptreact"],
  "absolute": true
}
