#!/usr/bin/env python3
"""omnipost-allow — creates expiring authorization tokens for sensitive operations."""

import argparse
import json
import sys
from datetime import datetime, timezone, timedelta
from pathlib import Path


# Allowed operations with their default TTL in minutes.
ALLOWED_OPERATIONS = {
    "push": {
        "description": "authorized git push",
        "default_ttl_minutes": 15,
    },
    "sensitive-edit": {
        "description": "authorized edit of a sensitive file (hooks/CI/env/schema)",
        "default_ttl_minutes": 15,
    },
    # New operations are added here:
    # "deploy": {"description": "production deployment", "default_ttl_minutes": 5},
}

# Resolved from the script's location (.claude/bin/ -> .claude/ -> root), not
# from the cwd: run from a subdirectory, the token would land in
# <subdir>/.claude/.allowed, where no hook looks for it.
TOKENS_DIR = Path(__file__).resolve().parents[2] / ".claude" / ".allowed"


def list_operations() -> str:
    """Returns a string listing the available operations."""
    lines = []
    for op, meta in ALLOWED_OPERATIONS.items():
        lines.append(f"  {op:<10} — {meta['description']} (TTL default: {meta['default_ttl_minutes']} min)")
    return "\n".join(lines)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Creates an authorization token for a sensitive operation.",
        epilog=f"Available operations:\n{list_operations()}",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "operation",
        help="Name of the operation to authorize (e.g. 'push').",
    )
    parser.add_argument(
        "--ttl",
        type=int,
        default=None,
        help="Token lifetime in minutes. When omitted, the operation's default is used.",
    )

    args = parser.parse_args()

    if args.operation not in ALLOWED_OPERATIONS:
        print(f"Unknown operation '{args.operation}'.", file=sys.stderr)
        print(f"\nAvailable operations:\n{list_operations()}", file=sys.stderr)
        sys.exit(1)

    operation_meta = ALLOWED_OPERATIONS[args.operation]
    ttl_minutes = args.ttl if args.ttl is not None else operation_meta["default_ttl_minutes"]

    if ttl_minutes <= 0:
        print(f"TTL must be positive. Received: {ttl_minutes}", file=sys.stderr)
        sys.exit(1)

    now = datetime.now(timezone.utc)
    expires_at = now + timedelta(minutes=ttl_minutes)

    token_data = {
        "operation": args.operation,
        "created_at": now.isoformat(),
        "expires_at": expires_at.isoformat(),
        "ttl_minutes": ttl_minutes,
        "authorized_by": "edward",
    }

    TOKENS_DIR.mkdir(parents=True, exist_ok=True)
    token_path = TOKENS_DIR / args.operation

    if token_path.exists():
        print(f"A token for '{args.operation}' already exists. It will be replaced.", file=sys.stderr)

    with token_path.open("w") as f:
        json.dump(token_data, f, indent=2)

    expires_local = expires_at.astimezone()  # local timezone, for display
    print(f"✓ Token '{args.operation}' created")
    print(f"  Path:    {token_path}")
    print(f"  Expires: {expires_local.strftime('%H:%M:%S')} ({ttl_minutes} minutes)")


if __name__ == "__main__":
    main()
