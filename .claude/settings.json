{
  "_README": "Hooks Python para OmniPost — turno 4 del aprendizaje incremental.",

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks-py/pre_bash.py"
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks-py/post_bash.py"
          }
        ]
      }
    ]
  }
}
