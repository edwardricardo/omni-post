{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        ".dependency-cruiser-resolve.cjs",
        "eslint.jsdoc.config.ts",
        "scripts/rls-ab-measurement.ts",
        "scripts/testing/metrics.mjs",
        "scripts/testing/lib/ledger-core.mjs",
        "scripts/testing/lib/dependency-sites.mjs",
        "scripts/testing/lib/dependency-manifests.mjs",
        "scripts/testing/lib/dependency-ledger-core.mjs",
        "scripts/testing/battery-state.mjs",
        "scripts/testing/sentry-init-probe.mjs",
        "scripts/testing/node-summary-reporter.mjs",
        "scripts/legal/lib/inventory.mjs",
        "scripts/legal/lib/source-scan.mjs",
        "scripts/legal/personal-data.mjs",
        "scripts/legal/cookies-and-storage.mjs",
        "scripts/legal/oauth-scopes.mjs",
        "scripts/legal/subprocessors.mjs",
        "scripts/support/index.mjs",
        "scripts/support/non-features.mjs",
        "scripts/support/run.mjs"
      ],
      "project": ["*.{ts,js,cjs,mjs}", "scripts/**/*.{ts,js,mjs}"],
      "ignore": ["performance/**", "security/**", "scripts/migrations/**", "scripts/depscan.mjs"],
      "ignoreBinaries": ["du"],
      "ignoreDependencies": [
        "react",
        "@secretlint/secretlint-rule-preset-recommend",
        "msw",
        "@t3-oss/env-core",
        "@t3-oss/env-nextjs"
      ]
    },
    "apps/api": {
      "project": ["src/**/*.{ts,tsx}"],
      "entry": ["tests/**/*.{integration,live}.test.ts"],
      "ignore": ["tests/**", "src/**/*.test.ts", "reports/**", "scripts/**"]
    },
    "apps/workers": {
      "entry": ["src/publishWorker.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["tests/**"]
    },
    "apps/admin": {
      "project": ["**/*.{ts,tsx}"],
      "paths": { "@/*": ["./*"] },
      "ignore": ["tests/**", "**/ui-safelist.ts", "**/useAuditStats.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/client": {
      "project": ["**/*.{ts,tsx}"],
      "paths": { "@/*": ["./*"] },
      "ignore": ["tests/**"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/shared": {
      "entry": ["src/index.ts", "src/**/*.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["src/**/*.js", "src/**/*.d.ts"]
    },
    "packages/ports": {
      "project": ["src/**/*.ts"],
      "ignore": ["src/**/*.js", "src/**/*.d.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"],
      "ignore": ["tests/**"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/api-common": {
      "project": ["src/**/*.ts"],
      "ignore": ["tests/**"]
    },
    "packages/providers/shared": {
      "project": ["src/**/*.ts"],
      "ignore": ["tests/**"]
    },
    "packages/providers/x": {
      "project": ["src/**/*.ts"],
      "ignore": ["tests/**"]
    },
    "packages/providers/instagram": {
      "project": ["src/**/*.ts"],
      "ignore": ["tests/**"]
    },
    "packages/providers/facebook": {
      "project": ["src/**/*.ts"],
      "ignore": ["tests/**"]
    },
    "packages/providers/youtube": {
      "project": ["src/**/*.ts"],
      "ignore": ["tests/**"]
    },
    "packages/providers/tiktok": {
      "project": ["src/**/*.ts"],
      "ignore": ["tests/**"]
    },
    "packages/providers/_template": {
      "project": ["src/**/*.ts"]
    },
    "packages/adapters/cache-redis": {
      "project": ["src/**/*.ts"],
      "ignore": ["tests/**"]
    },
    "packages/adapters/db-prisma": {
      "project": ["src/**/*.ts"]
    },
    "packages/adapters/queue-bullmq": {
      "project": ["src/**/*.ts"]
    },
    "packages/adapters/external-apis": {
      "project": ["src/**/*.ts"]
    },
    "packages/adapters/storage-cloudinary": {
      "project": ["src/**/*.ts"]
    },
    "packages/adapters/storage-s3": {
      "project": ["src/**/*.ts"]
    },
    "packages/adapters/dead-letter-queue": {
      "project": ["src/**/*.ts"]
    },
    "packages/adapters/fallback-strategies": {
      "project": ["src/**/*.ts"]
    },
    "packages/observability/logger": {
      "project": ["src/**/*.ts"]
    },
    "packages/observability/opentelemetry": {
      "project": ["src/**/*.ts"]
    },
    "packages/test-contracts": {
      "entry": ["src/reach.ts", "src/scopes.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "infra/prisma": {
      "project": ["src/**/*.ts"],
      "ignore": ["src/**/*.d.ts"],
      "ignoreDependencies": ["@prisma/client"]
    }
  },
  "ignoreDependencies": ["tw-animate-css"]
}
