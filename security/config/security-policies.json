{
  "security_policies": {
    "version": "1.0.0",
    "last_updated": "2024-03-15",
    "description": "Comprehensive security policies for Social Media CMS platform",

    "general": {
      "severity_thresholds": {
        "critical": {
          "description": "Critical vulnerabilities that require immediate attention",
          "max_allowed": 0,
          "action": "block_deployment"
        },
        "high": {
          "description": "High severity vulnerabilities that should be fixed quickly",
          "max_allowed": 0,
          "action": "require_approval"
        },
        "medium": {
          "description": "Medium severity vulnerabilities that should be addressed",
          "max_allowed": 5,
          "action": "warning"
        },
        "low": {
          "description": "Low severity vulnerabilities for informational purposes",
          "max_allowed": 20,
          "action": "informational"
        }
      },
      "scan_frequency": {
        "sast": "on_every_commit",
        "dast": "daily",
        "dependency": "daily",
        "container": "on_image_build"
      }
    },

    "authentication": {
      "password_policy": {
        "minimum_length": 12,
        "require_uppercase": true,
        "require_lowercase": true,
        "require_numbers": true,
        "require_special_chars": true,
        "forbidden_patterns": ["password", "123456", "qwerty", "admin", "user", "test"],
        "max_age_days": 90,
        "prevent_reuse_count": 12
      },
      "session_management": {
        "max_session_duration_minutes": 1440,
        "idle_timeout_minutes": 30,
        "concurrent_sessions_limit": 5,
        "require_reauth_for_sensitive_operations": true
      },
      "mfa": {
        "required_for_admin": true,
        "required_for_api_access": true,
        "backup_codes_count": 10,
        "totp_window_seconds": 30
      },
      "account_lockout": {
        "max_failed_attempts": 5,
        "lockout_duration_minutes": 30,
        "progressive_delay": true
      }
    },

    "input_validation": {
      "sql_injection": {
        "enabled": true,
        "patterns": [
          "(?i)(SELECT|INSERT|UPDATE|DELETE|DROP|CREATE|ALTER|EXEC|UNION|SCRIPT)\\b",
          "(-{2}|\\/\\*|\\*\\/)",
          "(?i)(\\bOR\\s+\\d+\\s*=\\s*\\d+)",
          "(['\"`;])",
          "(?i)(\\bxp_\\w+)",
          "(?i)(DROP\\s+TABLE)",
          "(?i)(;\\s*DROP)",
          "(?i)('\\s*;\\s*DROP)",
          "(?i)('\\s*OR\\s*'\\w*'\\s*=\\s*'\\w*)"
        ],
        "action": "block"
      },
      "xss_prevention": {
        "enabled": true,
        "patterns": [
          "<script[^>]*>.*?<\\/script>",
          "<script[^>]*>",
          "<\\/script>",
          "<iframe[^>]*>.*?<\\/iframe>",
          "<object[^>]*>.*?<\\/object>",
          "<embed[^>]*>",
          "<link[^>]*>",
          "javascript:",
          "vbscript:",
          "onload\\s*=",
          "onclick\\s*=",
          "onerror\\s*=",
          "onmouseover\\s*=",
          "onfocus\\s*=",
          "onblur\\s*=",
          "alert\\s*\\(",
          "<.*on\\w+\\s*="
        ],
        "action": "sanitize"
      },
      "nosql_injection": {
        "enabled": true,
        "forbidden_operators": [
          "$ne",
          "$gt",
          "$regex",
          "$where",
          "$exists",
          "$in",
          "$nin",
          "$or",
          "$and"
        ],
        "action": "block"
      },
      "command_injection": {
        "enabled": true,
        "patterns": [
          "[;&|`$(){}\\[\\]]",
          "\\b(cat|ls|pwd|whoami|id|uname|ps|netstat|ifconfig|wget|curl|nc|ncat|telnet|ssh|scp|rsync)\\b",
          "(>|>>|<|\\||&)",
          "(\\$\\(|`)",
          "(;\\s*ls\\s)",
          "(test;\\s*ls)",
          "(ls\\s*-la)"
        ],
        "action": "block"
      },
      "path_traversal": {
        "enabled": true,
        "patterns": [
          "\\.\\.",
          "\\/\\.\\.\\/",
          "\\\\\\.\\.\\\\/",
          "%2e%2e",
          "%252e%252e",
          "\\.\\.\\/etc\\/passwd",
          "\\.\\.\\\\etc\\\\passwd",
          "\\.\\.\\/.*"
        ],
        "action": "block"
      }
    },

    "api_security": {
      "rate_limiting": {
        "global": {
          "requests_per_minute": 1000,
          "burst_limit": 100
        },
        "authentication": {
          "requests_per_minute": 10,
          "burst_limit": 5
        },
        "api_endpoints": {
          "requests_per_minute": 300,
          "burst_limit": 50
        },
        "file_upload": {
          "requests_per_minute": 20,
          "burst_limit": 5
        }
      },
      "input_limits": {
        "max_request_size_mb": 10,
        "max_json_depth": 10,
        "max_array_length": 1000,
        "max_string_length": 10000,
        "max_file_size_mb": 100
      },
      "cors": {
        "allowed_origins": ["https://app.omni-post.com", "https://admin.omni-post.com"],
        "allowed_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
        "allowed_headers": ["Content-Type", "Authorization", "X-Requested-With"],
        "allow_credentials": true,
        "max_age_seconds": 86400
      },
      "security_headers": {
        "strict_transport_security": "max-age=31536000; includeSubDomains; preload",
        "content_security_policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
        "x_content_type_options": "nosniff",
        "x_frame_options": "DENY",
        "x_xss_protection": "1; mode=block",
        "referrer_policy": "strict-origin-when-cross-origin",
        "permissions_policy": "geolocation=(), microphone=(), camera=(), fullscreen=()"
      }
    },

    "data_protection": {
      "encryption": {
        "algorithm": "AES-256-GCM",
        "key_rotation_days": 90,
        "encrypt_at_rest": [
          "user_credentials",
          "provider_tokens",
          "personal_data",
          "payment_information"
        ],
        "encrypt_in_transit": true
      },
      "pii_handling": {
        "anonymization_required": true,
        "retention_days": 365,
        "deletion_methods": ["secure_overwrite", "cryptographic_erasure"],
        "consent_tracking": true
      },
      "audit_logging": {
        "log_level": "INFO",
        "retain_days": 90,
        "events_to_log": [
          "authentication_attempts",
          "authorization_failures",
          "data_access",
          "data_modifications",
          "admin_actions",
          "security_events"
        ],
        "exclude_sensitive_data": true
      }
    },

    "infrastructure": {
      "container_security": {
        "base_image_scanning": true,
        "vulnerability_scanning": true,
        "runtime_protection": true,
        "network_policies": true,
        "resource_limits": true
      },
      "network_security": {
        "tls_version": "1.3",
        "cipher_suites": [
          "TLS_AES_256_GCM_SHA384",
          "TLS_AES_128_GCM_SHA256",
          "TLS_CHACHA20_POLY1305_SHA256"
        ],
        "certificate_transparency": true,
        "hsts_enabled": true
      },
      "secrets_management": {
        "vault_integration": true,
        "rotation_schedule": "monthly",
        "encryption_at_rest": true,
        "access_logging": true
      }
    },

    "compliance": {
      "gdpr": {
        "enabled": true,
        "data_subject_rights": [
          "access",
          "rectification",
          "erasure",
          "portability",
          "restriction",
          "objection"
        ],
        "consent_management": true,
        "breach_notification_hours": 72
      },
      "ccpa": {
        "enabled": true,
        "disclosure_requirements": true,
        "opt_out_rights": true,
        "non_discrimination": true
      },
      "soc2": {
        "enabled": true,
        "security_principle": true,
        "availability_principle": true,
        "processing_integrity": true,
        "confidentiality": true,
        "privacy": true
      }
    },

    "incident_response": {
      "severity_levels": {
        "critical": {
          "response_time_minutes": 15,
          "escalation_contacts": ["security-team", "management"],
          "automated_actions": ["isolate_affected_systems", "notify_stakeholders"]
        },
        "high": {
          "response_time_minutes": 60,
          "escalation_contacts": ["security-team"],
          "automated_actions": ["log_incident", "notify_team"]
        },
        "medium": {
          "response_time_minutes": 240,
          "escalation_contacts": ["development-team"],
          "automated_actions": ["log_incident"]
        },
        "low": {
          "response_time_minutes": 1440,
          "escalation_contacts": ["development-team"],
          "automated_actions": ["log_incident"]
        }
      },
      "communication": {
        "internal_channels": ["slack", "email", "pagerduty"],
        "external_notification": {
          "customers": true,
          "regulators": true,
          "law_enforcement": "if_required"
        }
      }
    },

    "monitoring": {
      "security_events": [
        "authentication_failures",
        "authorization_violations",
        "injection_attempts",
        "unusual_traffic_patterns",
        "privilege_escalations",
        "data_exfiltration_attempts"
      ],
      "alerting": {
        "real_time": ["critical", "high"],
        "daily_summary": ["medium", "low"],
        "weekly_report": ["all"]
      },
      "metrics": {
        "security_score": true,
        "vulnerability_trends": true,
        "incident_metrics": true,
        "compliance_status": true
      }
    }
  }
}
