#!/usr/bin/env bash
# Pre-commit hook — defense-in-depth for secrets + lint + format.
#
# Order matters:
#   1. gitleaks scans STAGED diff before any other tool runs (catches secrets
#      before they enter local git history). Graceful skip when binary is not
#      installed — CI still hard-fails so dev onboarding is not blocked.
#   2. lint-staged runs the file-glob pipelines: eslint --fix, prettier
#      --write, secretlint over staged files.

set -e

# Augment PATH so user-local installs (gitleaks, etc.) are visible. Git hooks
# run in non-interactive shells which skip ~/.bashrc, so the user's interactive
# PATH is not inherited. ~/.local/bin is the XDG canonical location for
# user-installed binaries.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# lint-staged (eslint --fix + prettier over the staged set) exceeds Node's
# default old-space heap on memory-capped dev environments (LXC). Raise it
# here unless the caller already set NODE_OPTIONS.
export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=6144}"

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner
else
  echo "⚠️  gitleaks not installed — skipping pre-commit secret scan."
  echo "   Install: https://github.com/gitleaks/gitleaks#installation"
  echo "   CI will still scan, so this is a local-feedback warning only."
fi

npx lint-staged
