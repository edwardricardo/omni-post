{
  "name": "@infra/prisma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "prisma": "prisma",
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "migrate": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "tsx --conditions development seed.ts"
  },
  "dependencies": {
    "@observability/logger": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "catalog:",
    "argon2": "catalog:",
    "dotenv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prisma": "7.9.1",
    "tsx": "catalog:"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./extensions/*": {
      "development": "./src/extensions/*",
      "default": "./dist/src/extensions/*"
    },
    "./*": {
      "development": "./src/*",
      "default": "./dist/src/*"
    }
  }
}
