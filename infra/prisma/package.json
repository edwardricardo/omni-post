{
  "name": "@infra/prisma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "prisma": "prisma",
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "migrate": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "tsx seed.ts"
  },
  "dependencies": {
    "@observability/logger": "workspace:*",
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "argon2": "0.44.0",
    "dotenv": "17.2.2"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "prisma": "7.6.0",
    "tsx": "4.21.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./extensions/*": "./dist/src/extensions/*",
    "./*": "./dist/src/*"
  }
}
