{
  "name": "@infra/prisma",
  "private": true,
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "schema.prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "prisma": "prisma",
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "migrate": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "tsx --conditions development seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@observability/logger": "workspace:*",
    "@types/node": "catalog:",
    "argon2": "catalog:",
    "dotenv": "catalog:",
    "prisma": "7.10.0",
    "tsx": "catalog:"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./extensions/*": {
      "development": "./src/extensions/*",
      "default": "./dist/src/extensions/*"
    },
    "./*": {
      "development": "./src/*",
      "default": "./dist/src/*"
    }
  }
}
