// Enhanced Template System Models

model Template {
  id        String @id @default(uuid())
  projectId String
  accountId String

  // Template metadata
  name        String
  description String?
  category    String
  platforms   String[] @default([])
  tags        String[] @default([])

  // Template content and structure
  content   String // Handlebars template content
  variables Json   @default("[]") // TemplateVariable[]
  variants  Json   @default("[]") // TemplateVariant[]

  // Versioning
  version  Int     @default(1)
  isActive Boolean @default(true)

  // Timestamps
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // Relationships
  project         Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account         Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  versions        TemplateVersion[]
  abTests         ABTest[]
  usageEvents     TemplateUsageEvent[]
  componentUsages TemplateComponentUsage[]
  commits         TemplateCommit[]
  collaborations  TemplateCollaboration[]
  analytics       TemplateAnalytics[]

  @@index([projectId, isActive], where: { deletedAt: null })
  @@index([accountId, isActive], where: { deletedAt: null })
  @@index([category], where: { deletedAt: null })
  @@index([platforms], where: { deletedAt: null })
  @@index([tags], where: { deletedAt: null })
  @@index([deletedAt])
}

model TemplateVersion {
  id         String @id @default(uuid())
  templateId String

  // Version details
  version   Int
  content   String
  variables String[] @default([])
  platforms String[] @default([])
  tags      String[] @default([])

  // Change tracking
  changeLog     String
  commitMessage String?
  author        Json // { id, name, avatar? }

  // Version control
  isActive        Boolean @default(false)
  parentVersionId String?
  branchName      String  @default("main")

  // Timestamps
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // Relationships
  template      Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parentVersion TemplateVersion?  @relation("VersionHistory", fields: [parentVersionId], references: [id])
  childVersions TemplateVersion[] @relation("VersionHistory")

  @@unique([templateId, version])
  @@index([templateId, isActive])
  @@index([templateId, branchName])
  @@index([parentVersionId])
  @@index([createdAt])
}

model ABTest {
