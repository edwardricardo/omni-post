  id                String              @id @default(uuid())
  accountId         String
  projectId         String
  channelId         String
  conversationId    String?
  provider          Provider
  providerMessageId String
  providerParentId  String?
  messageType       SocialMessageType
  authorName        String
  authorHandle      String?
  authorAvatarUrl   String?
  authorProviderId  String
  body              String
  mediaUrls         String[]            @default([])
  webhookEventId    String?             @unique
  relatedPostId     String?
  status            SocialMessageStatus @default(UNREAD)
  assigneeId        String?
  isArchived        Boolean             @default(false)
  providerCreatedAt DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  account         Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel         Channel              @relation(fields: [channelId], references: [id])
  conversation    SocialConversation?  @relation(fields: [conversationId], references: [id])
  webhookEvent    WebhookEvent?        @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)
  relatedPost     Post?                @relation(fields: [relatedPostId], references: [id], onDelete: SetNull)
  assignee        TeamMember?          @relation("MessageAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  outboundReplies SocialOutboundReply[]

  @@unique([provider, providerMessageId])
  @@index([accountId, projectId, status])
  @@index([conversationId])
  @@index([channelId, messageType])
  @@index([assigneeId, status])
  @@index([providerCreatedAt])
  @@index([relatedPostId])
}

model SocialConversation {
  id                    String    @id @default(uuid())
  accountId             String
  projectId             String
  channelId             String
  provider              Provider
  subject               String?
  participantCount      Int       @default(1)
  messageCount          Int       @default(0)
  lastMessageAt         DateTime
  isResolved            Boolean   @default(false)
  resolvedAt            DateTime?
  resolvedById          String?
  rootProviderMessageId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  account    Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel    Channel         @relation(fields: [channelId], references: [id])
  messages   SocialMessage[]
  resolvedBy TeamMember?     @relation("ConversationResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([accountId, projectId, isResolved])
  @@index([channelId, provider])
  @@index([lastMessageAt])
}

model SocialOutboundReply {
  id              String              @id @default(uuid())
  socialMessageId String
  authorId        String
  body            String
  providerReplyId String?
  status          OutboundReplyStatus @default(PENDING)
  errorMessage    String?
  sentAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  socialMessage SocialMessage @relation(fields: [socialMessageId], references: [id], onDelete: Cascade)
  author        TeamMember    @relation(fields: [authorId], references: [id])

  @@index([socialMessageId])
  @@index([authorId])
  @@index([status])
}

// ============================================================================
// Phase 3: Analytics & Reporting
// ============================================================================

model Campaign {
  id          String         @id @default(uuid())
  projectId   String
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  utmSource   String?
  utmMedium   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  posts   CampaignPost[]

  @@index([projectId, status])
  @@index([projectId, createdAt])
}

model CampaignPost {
  campaignId String
  postId     String
  taggedAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([campaignId, postId])
  @@index([postId])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model AnalyticsDailySummary {
  id        String   @id @default(uuid())
  postId    String?
  channelId String
  provider  Provider
  date      DateTime @db.Date
  views     Int      @default(0)
  likes     Int      @default(0)
  comments  Int      @default(0)
  shares    Int      @default(0)
  records   Int      @default(0)

  @@unique([postId, channelId, provider, date])
  @@index([channelId, date])
  @@index([provider, date])
}

model AnalyticsMonthlySummary {
  id        String   @id @default(uuid())
  postId    String?
  channelId String
  provider  Provider
  month     DateTime @db.Date
  views     Int      @default(0)
  likes     Int      @default(0)
  comments  Int      @default(0)
  shares    Int      @default(0)
  records   Int      @default(0)

  @@unique([postId, channelId, provider, month])
  @@index([channelId, month])
  @@index([provider, month])
}

model ScheduledReport {
  id           String       @id @default(uuid())
  projectId    String
  name         String
  cronSchedule String
  format       ReportFormat @default(CSV)
  recipients   String[]
  filters      Json         @default("{}")
  isActive     Boolean      @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isActive])
  @@index([nextRunAt, isActive])
}

enum ReportFormat {
  CSV
  JSON
}
