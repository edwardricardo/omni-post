enum SsoProvider {
  NONE
  SAML
  OIDC
}

// ── SSO / SAML + OIDC ──────────────────────────────────────────────────────

model SamlConfiguration {
  id               String   @id @default(cuid())
  accountId        String   @unique
  entityId         String
  idpEntityId      String
  idpSsoUrl        String
  idpCertificate   String   @db.Text
  attributeMapping Json
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model SamlSession {
  id         String   @id @default(cuid())
  accountId  String
  relayState String   @unique
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([relayState])
  @@index([expiresAt])
}

model OidcConfiguration {
  id        String @id @default(cuid())
  accountId String @unique
  issuerUrl String
  clientId  String
  // OIDC client secret — wrapped via EncryptionService (AES-256-GCM).
  // Plaintext never persisted; the OAuth handshake decrypts on demand.
  clientSecretCiphertext String
  clientSecretIv         String
  clientSecretAuthTag    String
  clientSecretKeyVersion Int      @default(1)
  scopes                 String[] @default(["openid", "email", "profile"])
  attributeMapping       Json
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([clientSecretKeyVersion])
}

