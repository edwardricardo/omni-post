  socialConversations       SocialConversation[]
  analyticsDailySummaries   AnalyticsDailySummary[]
  analyticsMonthlySummaries AnalyticsMonthlySummary[]
  deletedAt                 DateTime?                 @db.Timestamptz(6)
  // Channel auth lifecycle. `needsReauth` is flipped by workers when
  // the provider returns AUTH; cleared when the user completes the OAuth
  // re-grant flow. `authFailedAt` and `authFailureReason` retain context
  // for inspection / debug.
  needsReauth               Boolean                   @default(false)
  authFailedAt              DateTime?                 @db.Timestamptz(6)
  authFailureReason         String?

  @@unique([projectId, provider], where: { isPrimary: true, deletedAt: null }, map: "Channel_projectId_provider_isPrimary_unique")
  @@index([projectId], where: { deletedAt: null })
  @@index([provider], where: { deletedAt: null })
  @@index([projectId, provider], where: { deletedAt: null })
  @@index([createdAt], where: { deletedAt: null })
  @@index([deletedAt])
  @@index([needsReauth], where: { needsReauth: true }, map: "Channel_needsReauth_idx")
  @@index([credentialsKeyVersion])
  @@index([provider, providerAccountId], where: { deletedAt: null })
}

