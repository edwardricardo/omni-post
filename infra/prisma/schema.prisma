enum TrendUrgency {
  NOW
  TODAY
  THIS_WEEK
}

// ─── Platform Configuration ──────────────────────────────────────────────────

model PlatformCredential {
  id             String          @id @default(cuid())
  group          CredentialGroup
  key            String
  encryptedValue String
  iv             String
  authTag        String
  // KEK version that wrapped this row's ciphertext. Lets the EncryptionService
  // dispatch to the correct key when reading; lets re-wrap scripts identify
  // rows still on a prior key. Defaults to 1 — the steady-state value before
  // the first rotation.
  keyVersion     Int             @default(1)
  isActive       Boolean         @default(true)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  updatedBy      String?

  @@unique([group, key])
  @@index([group])
  @@index([keyVersion])
}

model AccountCredential {
  id             String                 @id @default(cuid())
  accountId      String
  group          AccountCredentialGroup
  key            String
  encryptedValue String
  iv             String
  authTag        String
  // KEK version that wrapped this row's ciphertext (see PlatformCredential.keyVersion).
  keyVersion     Int                    @default(1)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, group, key])
  @@index([accountId, group])
  @@index([keyVersion])
}

model PlatformEncryptionKey {
  id         String   @id @default(cuid())
  keyVersion Int      @default(1)
  rotatedAt  DateTime @default(now()) @db.Timestamptz(6)
  rotatedBy  String
  note       String?
  isActive   Boolean  @default(true)
}

enum CredentialGroup {
  STRIPE
  PADDLE
  RESEND
  STORAGE
  MONITORING
  AI_POOL
  PLATFORM
  SOCIAL_FACEBOOK
  SOCIAL_INSTAGRAM
  SOCIAL_X
  SOCIAL_YOUTUBE
  SOCIAL_TIKTOK
  SOCIAL_LINKEDIN
  SOCIAL_SNAPCHAT
  SOCIAL_TELEGRAM
  SOCIAL_PINTEREST
  SOCIAL_BLUESKY
  SOCIAL_THREADS
}

enum AccountCredentialGroup {
  AI_BYOK
}

model AiTokenUsage {
  id         String   @id @default(cuid())
  accountId  String
  provider   String
  tokensUsed Int
  usedAt     DateTime @default(now()) @db.Timestamptz(6)
  isByok     Boolean  @default(false)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, usedAt])
}

/// Append-only event store for the event sourcing pipeline (saga + CQRS).
/// Replaces the runtime-created `stored_events` table — schema lives here so
/// Prisma Client can read/write events with type safety and migrations stay
/// version-controlled.
model StoredEvent {
  id            String   @id
  streamId      String   @map("stream_id")
  eventType     String   @map("event_type")
  eventData     String   @map("event_data")
  metadata      String   @default("{}")
  version       Int
  sequence      BigInt
  timestamp     DateTime @default(now()) @db.Timestamptz(6)
  correlationId String?  @map("correlation_id")
  causationId   String?  @map("causation_id")

  @@unique([streamId, version], map: "idx_stored_events_stream_version")
  @@index([streamId], map: "idx_stored_events_stream_id")
  @@index([sequence], map: "idx_stored_events_sequence")
  @@map("stored_events")
}

/// Aggregate state snapshots for fast rehydration of long-lived event streams.
/// One snapshot per stream (the most recent); upsert pattern keyed by streamId.
/// Wired by `EventStore.createSnapshot` / `getSnapshot`; consumers per
/// aggregate decide when to emit a snapshot based on domain triggers.
model EventSnapshot {
  streamId  String   @id @map("stream_id")
  version   Int
  data      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("event_snapshots")
}
