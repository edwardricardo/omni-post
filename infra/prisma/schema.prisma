  receivedAt  DateTime  @default(now()) @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  // Relationships
  account       Account?       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  post          Post?          @relation(fields: [postId], references: [id], onDelete: SetNull)
  socialMessage SocialMessage?

  @@unique([provider, eventId]) // Prevent duplicate events
  @@index([provider, eventType])
  @@index([status, nextRetryAt])
  @@index([accountId, provider])
  @@index([receivedAt])
  @@index([processed, status])
  @@index([channelId, eventType])
}

model WebhookSubscription {
  id        String  @id @default(uuid())
  accountId String
  projectId String?

  // Subscription details
  provider   Provider
  webhookUrl String // Our webhook endpoint URL
  secretKey  String // Secret for signature verification
  // Grace-window pair populated during admin-triggered rotation (PR-43-B).
  // While `previousSecretKeyExpiresAt > now()`, the HMAC verifier accepts
  // signatures produced with `previousSecretKey` so in-flight webhooks
  // delivered with the old shared secret are not rejected. Both columns
  // null = no rotation in progress.
  previousSecretKey          String?
  previousSecretKeyExpiresAt DateTime? @db.Timestamptz(6)
  isActive                   Boolean   @default(true)

  // Provider-specific configuration
  subscriptionId String? // Provider's subscription ID
  verifyToken    String? // Facebook verification token
  eventTypes     WebhookEventType[] // Subscribed event types

  // Subscription metadata
  expiresAt    DateTime? @db.Timestamptz(6) // Subscription expiration
  lastVerified DateTime? @db.Timestamptz(6) // Last successful verification

  // Statistics
  eventsReceived  Int       @default(0)
  eventsProcessed Int       @default(0)
  lastEventAt     DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Relationships
  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([accountId, provider, projectId])
  @@index([provider, isActive])
  @@index([expiresAt])
  @@index([lastEventAt])
}

model WebhookDeadLetter {
  id              String @id @default(uuid())
  originalEventId String @unique

  // Original event data
  provider  Provider
  eventType WebhookEventType
  payload   Json
  headers   Json

  // Failure information
  failureReason String
  finalError    String?
  retryCount    Int

  // Metadata
  firstFailedAt DateTime  @db.Timestamptz(6)
  lastRetryAt   DateTime  @db.Timestamptz(6)
  resolvedAt    DateTime? @db.Timestamptz(6)
  resolvedBy    String? // Admin user who resolved
  archivedAt    DateTime? @db.Timestamptz(6) // soft archive — null = active

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([provider, eventType])
  @@index([firstFailedAt])
  @@index([resolvedAt])
}

// ─── Outbox Dead Letter ─────────────────────────────────────────────────────

model OutboxDeadLetter {
  id              String    @id @default(cuid())
  originalEventId String    @unique
  eventType       String
  aggregateId     String
  aggregateType   String    @default("unknown")
  payload         Json
  failureReason   String
  retryCount      Int
  firstFailedAt   DateTime  @db.Timestamptz(6)
  archivedAt      DateTime  @default(now()) @db.Timestamptz(6)
  resolvedAt      DateTime? @db.Timestamptz(6)
  resolvedBy      String?

  @@index([resolvedAt])
}

