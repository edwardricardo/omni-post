  postId       String?
  campaignId   String?
  syncedAt     DateTime?       @db.Timestamptz(6)
  syncError    String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, syncedAt])
  @@index([contactEmail])
}

model CrmSyncLog {
  id               String     @id @default(cuid())
  connectionId     String
  startedAt        DateTime   @default(now()) @db.Timestamptz(6)
  completedAt      DateTime?  @db.Timestamptz(6)
  contactsSynced   Int        @default(0)
  activitiesSynced Int        @default(0)
  errors           Json?
  status           SyncStatus @default(RUNNING)

  connection CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
}

// ── Media Asset Library ─────────────────────────────────────────────────────

model MediaAsset {
  id          String    @id @default(uuid())
  accountId   String
  projectId   String?
  name        String
  description String?
  url         String
  storageKey  String
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  duration    Int?
  usageCount  Int       @default(0)
  folderId    String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  account Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project Project?          @relation(fields: [projectId], references: [id])
  folder  AssetFolder?      @relation(fields: [folderId], references: [id])
  tags    AssetTagOnAsset[]

  @@index([accountId], where: { deletedAt: null })
  @@index([projectId], where: { deletedAt: null })
  @@index([folderId], where: { deletedAt: null })
  @@index([mimeType], where: { deletedAt: null })
  @@index([deletedAt])
}

model AssetFolder {
  id        String   @id @default(uuid())
  accountId String
  name      String
  parentId  String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  account  Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  parent   AssetFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children AssetFolder[] @relation("FolderTree")
  assets   MediaAsset[]

  @@index([accountId])
  @@index([parentId])
}

model AssetTag {
  id        String   @id @default(uuid())
  accountId String
  name      String
  color     String?  @default("#6366f1")
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  account Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assets  AssetTagOnAsset[]

  @@unique([accountId, name])
  @@index([accountId])
}

model AssetTagOnAsset {
  assetId String
  tagId   String

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag   AssetTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
}

// ─── Provider-Based Billing ─────────────────────────────────────────────────

model ProviderPricingTier {
  id                    String   @id @default(cuid())
  minProviders          Int
  maxProviders          Int?
  /// Money: industry canon Decimal(19,4) — accommodates GAAP rounding tolerance + sub-cent precision.
  pricePerProviderMonth Decimal  @db.Decimal(19, 4)
  isActive              Boolean  @default(true)
  effectiveFrom         DateTime @default(now()) @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)

  @@unique([minProviders, isActive])
}

model AccountPricingTier {
  id            String   @id @default(cuid())
  minAccounts   Int
  maxAccounts   Int?
  /// Multiplier/rate: Decimal(10,6) — supports basis-point precision.
  multiplier    Decimal  @db.Decimal(10, 6)
  isActive      Boolean  @default(true)
  effectiveFrom DateTime @default(now()) @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([minAccounts, isActive])
}

model ProviderBundle {
  id                   String     @id @default(cuid())
  name                 String
  slug                 String     @unique
  description          String
  providers            Provider[]
  /// Money: industry canon Decimal(19,4).
  pricePerAccountMonth Decimal    @db.Decimal(19, 4)
  isActive             Boolean    @default(true)
  sortOrder            Int        @default(0)
  createdAt            DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @db.Timestamptz(6)

  subscriptions AccountSubscription[]
  featureFlags  BundleFeatureFlag[]
}

model BundleFeatureFlag {
  id         String  @id @default(cuid())
  bundleId   String?
  featureKey String
  isEnabled  Boolean @default(true)

  bundle ProviderBundle? @relation(fields: [bundleId], references: [id])

  @@unique([bundleId, featureKey])
}

model AccountSubscription {
  id                     String             @id @default(cuid())
  accountId              String             @unique
  bundleId               String?
  providers              Provider[]
  accountCount           Int                @default(1)
  maxProjects            Int                @default(3)
  /// Money: industry canon Decimal(19,4).
  pricePerMonth          Decimal            @db.Decimal(19, 4)
  status                 SubscriptionStatus @default(TRIALING)
  externalSubscriptionId String?
  externalCustomerId     String?
  billingCycle           BillingCycle       @default(MONTHLY)
  currentPeriodStart     DateTime?          @db.Timestamptz(6)
  currentPeriodEnd       DateTime?          @db.Timestamptz(6)
  trialEndsAt            DateTime?          @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean            @default(false)
  gatewayProvider        GatewayProvider    @default(STRIPE)
  gatewaySubscriptionId  String?            @unique
  createdAt              DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(6)

  account  Account                    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bundle   ProviderBundle?            @relation(fields: [bundleId], references: [id])
  history  SubscriptionPriceHistory[]
  invoices Invoice[]

  @@index([status])
}

model SubscriptionPriceHistory {
  id             String    @id @default(cuid())
  subscriptionId String
  /// Money: industry canon Decimal(19,4).
  previousPrice  Decimal   @db.Decimal(19, 4)
  /// Money: industry canon Decimal(19,4).
  newPrice       Decimal   @db.Decimal(19, 4)
  reason         String
  effectiveAt    DateTime  @db.Timestamptz(6)
  notifiedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  subscription AccountSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
}

model Invoice {
  id               String          @id @default(cuid())
  accountId        String
  subscriptionId   String?
  gatewayProvider  GatewayProvider
  gatewayInvoiceId String          @unique
  status           InvoiceStatus
  amountDue        Float
  amountPaid       Float           @default(0)
  currency         String          @default("usd")
  periodStart      DateTime        @db.Timestamptz(6)
  periodEnd        DateTime        @db.Timestamptz(6)
  paidAt           DateTime?       @db.Timestamptz(6)
  hostedUrl        String?
  pdfUrl           String?
  attemptCount     Int             @default(0)
  nextRetryAt      DateTime?       @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(6)

  account      Account              @relation(fields: [accountId], references: [id])
  subscription AccountSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([accountId])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
  PAYMENT_FAILED
}

model SystemAnnouncement {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      AnnouncementType @default(INFO)
  startsAt  DateTime         @db.Timestamptz(6)
  endsAt    DateTime?        @db.Timestamptz(6)
  isActive  Boolean          @default(true)
  createdBy String
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @db.Timestamptz(6)

  @@index([isActive, startsAt])
}

enum AnnouncementType {
  INFO
  WARNING
  MAINTENANCE
  CRITICAL
}

model AccountOnboarding {
  id                     String    @id @default(cuid())
  accountId              String    @unique
  connectedFirstProvider Boolean   @default(false)
  createdFirstPost       Boolean   @default(false)
  invitedTeamMember      Boolean   @default(false)
  configuredBilling      Boolean   @default(false)
  completedAt            DateTime? @db.Timestamptz(6)
  dismissedAt            DateTime? @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  GRANDFATHERED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// ─── Gateway Switching ──────────────────────────────────────────────────────

enum GatewayProvider {
  STRIPE
  PADDLE
}

enum SwitchStatus {
  SCHEDULED
  PENDING_CHECKOUT
  COMPLETED
  CANCELLED
  SUSPENDED
  EXPIRED
}

model GatewaySwitchEvent {
  id             String          @id @default(cuid())
  accountId      String
  fromGateway    GatewayProvider
  toGateway      GatewayProvider
  requestedAt    DateTime        @default(now()) @db.Timestamptz(6)
  scheduledFor   DateTime        @db.Timestamptz(6)
  completedAt    DateTime?       @db.Timestamptz(6)
  cancelledAt    DateTime?       @db.Timestamptz(6)
  reminderSentAt DateTime?       @db.Timestamptz(6)
  suspendedAt    DateTime?       @db.Timestamptz(6)
  extendedUntil  DateTime?       @db.Timestamptz(6)
  extendedBy     String?
  status         SwitchStatus    @default(SCHEDULED)
  metadata       Json?
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([status])
  @@index([scheduledFor])
}

model BillingEvent {
  id              String          @id @default(cuid())
  accountId       String?
  gatewayProvider GatewayProvider
  gatewayEventId  String          @unique
  eventType       String
  rawEventType    String
  payload         Json
  processed       Boolean         @default(false)
  processedAt     DateTime?       @db.Timestamptz(6)
  error           String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)

  account Account? @relation(fields: [accountId], references: [id])

  @@index([gatewayProvider, createdAt])
}

// ─── Compliance (GDPR/LGPD/CCPA/PIPEDA) ─────────────────────────────────────

enum DpoType {
  INTERNAL
  EXTERNAL
}

enum DsarRequestType {
  EXPORT
  DELETION
  ACCESS
}

enum DsarStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  EXPIRED
}

enum JurisdictionType {
  GDPR
  LGPD
  CCPA
  PIPEDA
  OTHER
}

model GdprSettings {
  id                       String           @id @default(cuid())
  privacyPolicyUrl         String?
  cookiePolicyUrl          String?
  termsOfServiceUrl        String?
  dpoType                  DpoType          @default(INTERNAL)
  dpoEmail                 String?
  dpoUrl                   String?
  dataRetentionDays        Int              @default(365)
  auditLogRetentionDays    Int              @default(90)
  enableAutoDataDeletion   Boolean          @default(false)
  dsarResponseDays         Int              @default(30)
  defaultJurisdiction      JurisdictionType @default(GDPR)
  enableRightToErasure     Boolean          @default(true)
  enableDataExport         Boolean          @default(true)
  enableDataAccess         Boolean          @default(true)
  enableBreachNotification Boolean          @default(true)
  updatedAt                DateTime         @updatedAt @db.Timestamptz(6)
  updatedBy                String?
}

model SecuritySettings {
  id                    String   @id @default(cuid())
  require2FA            Boolean  @default(false)
  sessionTimeoutMinutes Int      @default(1440)
  maxLoginAttempts      Int      @default(5)
  passwordMinLength     Int      @default(8)
  requireUppercase      Boolean  @default(false)
  requireSpecialChar    Boolean  @default(false)
  ipAllowlistEnabled    Boolean  @default(false)
  ipAllowlist           String[]
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)
  updatedBy             String?
}

model ConsentRecord {
  id             String    @id @default(cuid())
  userId         String?
  accountId      String?
  consentType    String
  consentVersion String
  acceptedAt     DateTime  @default(now()) @db.Timestamptz(6)
  ipAddress      String?
  userAgent      String?
  withdrawn      Boolean   @default(false)
  withdrawnAt    DateTime? @db.Timestamptz(6)

  @@index([userId, consentType])
  @@index([accountId])
}

model DsarRequest {
  id                String           @id @default(cuid())
  accountId         String?
  requestorEmail    String
  requestorName     String?
  type              DsarRequestType
  jurisdiction      JurisdictionType @default(GDPR)
  status            DsarStatus       @default(PENDING)
  deadlineAt        DateTime         @db.Timestamptz(6)
  requestedAt       DateTime         @default(now()) @db.Timestamptz(6)
  acknowledgedAt    DateTime?        @db.Timestamptz(6)
  completedAt       DateTime?        @db.Timestamptz(6)
  completedBy       String?
  rejectedAt        DateTime?        @db.Timestamptz(6)
  rejectedBy        String?
  rejectionReason   String?
  exportUrl         String?
  exportExpiresAt   DateTime?        @db.Timestamptz(6)
  notes             String?
  ipAddress         String?
  verificationToken String?          @unique

  account Account? @relation(fields: [accountId], references: [id])

  @@index([status, deadlineAt])
  @@index([requestorEmail])
}

model DataBreachReport {
  id                   String    @id @default(cuid())
  title                String
  description          String
  discoveredAt         DateTime  @db.Timestamptz(6)
  reportedAt           DateTime  @default(now()) @db.Timestamptz(6)
  reportedBy           String
  affectedUserCount    Int?
  dataTypesAffected    String[]
  severity             String
  notificationSentAt   DateTime? @db.Timestamptz(6)
  notificationSentBy   String?
  regulatoryReportedAt DateTime? @db.Timestamptz(6)
  regulatoryReportedTo String?
  resolved             Boolean   @default(false)
  resolvedAt           DateTime? @db.Timestamptz(6)
  internalNotes        String?
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)
}

// ─── Referral Program ───────────────────────────────────────────────────────

model ReferralCode {
  id          String   @id @default(cuid())
  accountId   String   @unique
  code        String   @unique
  usageCount  Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  referrals Referral[]
}

model Referral {
  id                String         @id @default(cuid())
  referralCodeId    String
  referredAccountId String?
  referredEmail     String
  status            ReferralStatus @default(PENDING)
  rewardGranted     Boolean        @default(false)
  convertedAt       DateTime?      @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)

  referralCode    ReferralCode @relation(fields: [referralCodeId], references: [id])
  referredAccount Account?     @relation("ReferredAccount", fields: [referredAccountId], references: [id], onDelete: SetNull)

  @@index([referralCodeId])
  @@index([referredAccountId])
}

enum ReferralStatus {
  PENDING
  CONVERTED
  REWARDED
  EXPIRED
}

// ─── Autonomous Post Repurposing ────────────────────────────────────────────

model RepurposeProposal {
  id                   String          @id @default(cuid())
  accountId            String
  sourcePostId         String
  sourcePlatform       Provider
  status               RepurposeStatus @default(PENDING)
  /// Rate: Decimal(10,6) — basis-point precision.
  engagementRate       Decimal         @db.Decimal(10, 6)
  /// Multiplier: Decimal(10,6) — basis-point precision.
  engagementMultiplier Decimal         @db.Decimal(10, 6)
  detectedAt           DateTime        @default(now()) @db.Timestamptz(6)
  reviewedAt           DateTime?       @db.Timestamptz(6)
  reviewedBy           String?

  account    Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sourcePost Post               @relation("RepurposeSource", fields: [sourcePostId], references: [id])
  variants   RepurposeVariant[]

  @@index([accountId, status])
  @@index([sourcePostId])
}

model RepurposeVariant {
  id         String          @id @default(cuid())
  proposalId String
  platform   Provider
  content    String          @db.Text
  hashtags   String[]
  status     RepurposeStatus @default(PENDING)
  postId     String?

  proposal RepurposeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  post     Post?             @relation("RepurposedPost", fields: [postId], references: [id])

  @@index([proposalId])
}

enum RepurposeStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

// ─── AI Inbox Triage ────────────────────────────────────────────────────────

enum MessagePriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

// ─── Trend Radar ────────────────────────────────────────────────────────────

model TrendRadarResult {
  id             String       @id @default(cuid())
  accountId      String
  topic          String
  platform       Provider
  relevanceScore Int
  postIdea       String?      @db.Text
  bestPlatform   Provider?
  urgency        TrendUrgency
