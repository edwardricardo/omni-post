  minAccounts   Int
  maxAccounts   Int?
  multiplier    Decimal  @db.Decimal(4, 3)
  isActive      Boolean  @default(true)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([minAccounts, isActive])
}

model ProviderBundle {
  id                   String     @id @default(cuid())
  name                 String
  slug                 String     @unique
  description          String
  providers            Provider[]
  pricePerAccountMonth Decimal    @db.Decimal(10, 2)
  isActive             Boolean    @default(true)
  sortOrder            Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  subscriptions    AccountSubscription[]
  featureFlags     BundleFeatureFlag[]
}

model BundleFeatureFlag {
  id         String          @id @default(cuid())
  bundleId   String?
  featureKey String
  isEnabled  Boolean         @default(true)

  bundle     ProviderBundle? @relation(fields: [bundleId], references: [id])

  @@unique([bundleId, featureKey])
}

model AccountSubscription {
  id                     String             @id @default(cuid())
  accountId              String             @unique
  bundleId               String?
  providers              Provider[]
  accountCount           Int                @default(1)
  maxProjects            Int                @default(3)
  pricePerMonth          Decimal            @db.Decimal(10, 2)
  status                 SubscriptionStatus @default(TRIALING)
  externalSubscriptionId String?
  externalCustomerId     String?
  billingCycle           BillingCycle       @default(MONTHLY)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  gatewayProvider        GatewayProvider    @default(STRIPE)
  gatewaySubscriptionId  String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  account Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bundle  ProviderBundle? @relation(fields: [bundleId], references: [id])
  history SubscriptionPriceHistory[]

  @@index([status])
}

model SubscriptionPriceHistory {
  id             String   @id @default(cuid())
  subscriptionId String
  previousPrice  Decimal  @db.Decimal(10, 2)
  newPrice       Decimal  @db.Decimal(10, 2)
  reason         String
  effectiveAt    DateTime
  notifiedAt     DateTime?
  createdAt      DateTime @default(now())

  subscription AccountSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  GRANDFATHERED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// ─── Gateway Switching (Sprint B) ───────────────────────────────────────────

enum GatewayProvider {
  STRIPE
  PADDLE
}

enum SwitchStatus {
  SCHEDULED
  PENDING_CHECKOUT
  COMPLETED
  CANCELLED
  SUSPENDED
  EXPIRED
}

model GatewaySwitchEvent {
  id             String          @id @default(cuid())
  accountId      String
  fromGateway    GatewayProvider
  toGateway      GatewayProvider
  requestedAt    DateTime        @default(now())
  scheduledFor   DateTime
  completedAt    DateTime?
  cancelledAt    DateTime?
  reminderSentAt DateTime?
  suspendedAt    DateTime?
  extendedUntil  DateTime?
  extendedBy     String?
  status         SwitchStatus    @default(SCHEDULED)
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([status])
  @@index([scheduledFor])
}

model BillingEvent {
  id              String          @id @default(cuid())
  accountId       String?
  gatewayProvider GatewayProvider
  gatewayEventId  String          @unique
  eventType       String
  rawEventType    String
  payload         Json
  processed       Boolean         @default(false)
  processedAt     DateTime?
  error           String?
  createdAt       DateTime        @default(now())

  account Account? @relation(fields: [accountId], references: [id])

  @@index([gatewayProvider, createdAt])
}

// ─── Compliance (Sprint C — GDPR/LGPD/CCPA/PIPEDA) ─────────────────────────

enum DpoType {
  INTERNAL
  EXTERNAL
}

enum DsarRequestType {
  EXPORT
  DELETION
  ACCESS
}

enum DsarStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  EXPIRED
}

enum JurisdictionType {
  GDPR
  LGPD
  CCPA
  PIPEDA
  OTHER
}

model GdprSettings {
  id                       String           @id @default(cuid())
  privacyPolicyUrl         String?
  cookiePolicyUrl          String?
  termsOfServiceUrl        String?
  dpoType                  DpoType          @default(INTERNAL)
  dpoEmail                 String?
  dpoUrl                   String?
  dataRetentionDays        Int              @default(365)
  auditLogRetentionDays    Int              @default(90)
  enableAutoDataDeletion   Boolean          @default(false)
  dsarResponseDays         Int              @default(30)
  defaultJurisdiction      JurisdictionType @default(GDPR)
  enableRightToErasure     Boolean          @default(true)
  enableDataExport         Boolean          @default(true)
  enableDataAccess         Boolean          @default(true)
  enableBreachNotification Boolean          @default(true)
  updatedAt                DateTime         @updatedAt
  updatedBy                String?
}

model SecuritySettings {
  id                    String   @id @default(cuid())
  require2FA            Boolean  @default(false)
  sessionTimeoutMinutes Int      @default(1440)
  maxLoginAttempts      Int      @default(5)
  passwordMinLength     Int      @default(8)
  requireUppercase      Boolean  @default(false)
  requireSpecialChar    Boolean  @default(false)
  ipAllowlistEnabled    Boolean  @default(false)
  ipAllowlist           String[]
  updatedAt             DateTime @updatedAt
  updatedBy             String?
}

model ConsentRecord {
  id             String    @id @default(cuid())
  userId         String?
  accountId      String?
  consentType    String
  consentVersion String
  acceptedAt     DateTime  @default(now())
  ipAddress      String?
  userAgent      String?
  withdrawn      Boolean   @default(false)
  withdrawnAt    DateTime?

  @@index([userId, consentType])
  @@index([accountId])
}

model DsarRequest {
  id                String           @id @default(cuid())
  accountId         String?
  requestorEmail    String
  requestorName     String?
  type              DsarRequestType
  jurisdiction      JurisdictionType @default(GDPR)
  status            DsarStatus       @default(PENDING)
  deadlineAt        DateTime
  requestedAt       DateTime         @default(now())
  acknowledgedAt    DateTime?
  completedAt       DateTime?
  completedBy       String?
  rejectedAt        DateTime?
  rejectedBy        String?
  rejectionReason   String?
  exportUrl         String?
  exportExpiresAt   DateTime?
  notes             String?
  ipAddress         String?
  verificationToken String?          @unique

  account Account? @relation(fields: [accountId], references: [id])

  @@index([status, deadlineAt])
  @@index([requestorEmail])
}

model DataBreachReport {
  id                   String   @id @default(cuid())
  title                String
  description          String
  discoveredAt         DateTime
  reportedAt           DateTime @default(now())
  reportedBy           String
  affectedUserCount    Int?
  dataTypesAffected    String[]
  severity             String
  notificationSentAt   DateTime?
  notificationSentBy   String?
  regulatoryReportedAt DateTime?
  regulatoryReportedTo String?
  resolved             Boolean  @default(false)
  resolvedAt           DateTime?
  internalNotes        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ─── Referral Program (Sprint 8) ────────────────────────────────────────────

model ReferralCode {
  id          String     @id @default(cuid())
  accountId   String     @unique
  code        String     @unique
  usageCount  Int        @default(0)
  conversions Int        @default(0)
  createdAt   DateTime   @default(now())

  account     Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  referrals   Referral[]
}

model Referral {
  id                String         @id @default(cuid())
  referralCodeId    String
  referredAccountId String?
  referredEmail     String
  status            ReferralStatus @default(PENDING)
  rewardGranted     Boolean        @default(false)
  convertedAt       DateTime?
  createdAt         DateTime       @default(now())

  referralCode      ReferralCode   @relation(fields: [referralCodeId], references: [id])

  @@index([referralCodeId])
  @@index([referredAccountId])
}

enum ReferralStatus {
  PENDING
  CONVERTED
  REWARDED
  EXPIRED
}

// ─── Autonomous Post Repurposing (Sprint 9) ─────────────────────────────────

model RepurposeProposal {
  id                   String          @id @default(cuid())
  accountId            String
  sourcePostId         String
  sourcePlatform       Provider
  status               RepurposeStatus @default(PENDING)
  engagementRate       Decimal         @db.Decimal(8, 4)
  engagementMultiplier Decimal         @db.Decimal(6, 2)
  detectedAt           DateTime        @default(now())
  reviewedAt           DateTime?
  reviewedBy           String?

  account    Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sourcePost Post                @relation("RepurposeSource", fields: [sourcePostId], references: [id])
  variants   RepurposeVariant[]

  @@index([accountId, status])
  @@index([sourcePostId])
}

model RepurposeVariant {
  id         String          @id @default(cuid())
  proposalId String
  platform   Provider
  content    String          @db.Text
  hashtags   String[]
  status     RepurposeStatus @default(PENDING)
  postId     String?

  proposal RepurposeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  post     Post?             @relation("RepurposedPost", fields: [postId], references: [id])

  @@index([proposalId])
}

enum RepurposeStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

// ─── AI Inbox Triage (Sprint 9) ─────────────────────────────────────────────

enum MessagePriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

// ─── Trend Radar (Sprint 9) ─────────────────────────────────────────────────

model TrendRadarResult {
  id             String       @id @default(cuid())
  accountId      String
  topic          String
  platform       Provider
  relevanceScore Int
  postIdea       String?      @db.Text
  bestPlatform   Provider?
  urgency        TrendUrgency
  volume         Int?
  fetchedAt      DateTime
  expiresAt      DateTime

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
}

enum TrendUrgency {
  NOW
  TODAY
  THIS_WEEK
}
