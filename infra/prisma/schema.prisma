// Outbox Pattern for reliable event publishing

model OutboxEvent {
  id            String    @id @default(uuid())
  eventType     String
  aggregateId   String
  aggregateType String
  payload       Json
  version       Int       @default(1)
  occurredAt    DateTime  @db.Timestamptz(6)
  publishedAt   DateTime? @db.Timestamptz(6)
  retryCount    Int       @default(0)
  maxRetries    Int       @default(5)
  nextRetryAt   DateTime  @default(now()) @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  claimedAt     DateTime? @db.Timestamptz(6)
  claimedBy     String?

  @@index([aggregateId, aggregateType])
  @@index([eventType])
  @@index([createdAt])
  @@index([nextRetryAt, occurredAt], where: raw("\"publishedAt\" IS NULL AND \"retryCount\" < \"maxRetries\""), map: "idx_outbox_claim_hot")
}

model OutboxInbox {
  messageId   String   @id
  processedAt DateTime @default(now()) @db.Timestamptz(6)
  consumerId  String

  @@index([processedAt])
  @@map("outbox_inbox")
}

// Saga Pattern - durable saga instance persistence

model SagaInstance {
  id                  String    @id
  definitionId        String
  status              String // PENDING | RUNNING | COMPLETED | FAILED | COMPENSATING | COMPENSATED
  currentStep         Int       @default(0)
  context             Json
  stepResults         Json      @default("[]")
  compensationResults Json      @default("[]")
  retryCount          Int       @default(0)
  error               String?
  accountId           String?
  startedAt           DateTime  @default(now()) @db.Timestamptz(6)
  completedAt         DateTime? @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, startedAt])
  @@index([definitionId, status])
  @@index([accountId, status])
  @@index([completedAt])
}

