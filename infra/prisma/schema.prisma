  children           PublishingQueue[]      @relation("QueueSequence")
  contentVersions    ContentVersion[]
  storyProject       InstagramStoryProject? @relation(fields: [storyProjectId], references: [id], onDelete: SetNull)
  videoProcessingJob VideoProcessingJob?    @relation(fields: [videoProcessingJobId], references: [id], onDelete: SetNull)

