  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@index([templateId])
  @@index([userId])
  @@index([role])
}

model TemplateAnalytics {
  id         String @id @default(uuid())
  templateId String

  // Usage metrics
  totalUses   Int    @default(0)
  uniqueUsers Int    @default(0)
