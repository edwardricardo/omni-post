generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma/client"
  previewFeatures = ["fullTextSearchPostgres", "relationJoins", "partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  name                     String
  maxProjects              Int                       @default(1)
  isOnTrial                Boolean                   @default(true)
  trialStartDate           DateTime                  @default(now()) @db.Timestamptz(6)
  trialEndDate             DateTime?                 @db.Timestamptz(6)
  autoRenewal              Boolean                   @default(false)
  billingCycle             String                    @default("monthly") // "monthly" or "yearly"
  lastBillingDate          DateTime?                 @db.Timestamptz(6)
  nextBillingDate          DateTime?                 @db.Timestamptz(6)
  stripeCustomerId         String?
  stripeSubscriptionId     String?
  slug                     String?                   @unique
  timezone                 String                    @default("UTC")
  locale                   String                    @default("en")
  phone                    String?
  maxTeamMembers           Int                       @default(5)
  maxStorageBytes          BigInt                    @default(5368709120)
  maxRecurringPosts        Int                       @default(5)
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(6)
  projects                 Project[]
  apiKeys                  ApiKey[]
  providerConnections      ProviderConnection[]
  contentTemplates         ContentTemplate[]
  publishingQueue          PublishingQueue[]
  instagramStoryProjects   InstagramStoryProject[]
  videoProcessingJobs      VideoProcessingJob[]
  instagramAnalytics       InstagramAnalytics[]
  schedulingRules          SchedulingRule[]
  webhookEvents            WebhookEvent[]
  webhookSubscriptions     WebhookSubscription[]
  templates                Template[]
  deletedAt                DateTime?                 @db.Timestamptz(6)
  teamMembers              TeamMember[]
  socialMessages           SocialMessage[]
  socialConversations      SocialConversation[]
  aiPromptTemplates        AIPromptTemplate[]
  usageMetrics             UsageMetric[]
  brandVoice               BrandVoice?
  brandKit                 BrandKit?
  integrationApiKeys       IntegrationApiKey[]
  approvalWorkflows        ApprovalWorkflow[]
  tasks                    Task[]
  integrationSubscriptions IntegrationSubscription[]
  samlConfiguration        SamlConfiguration?
  oidcConfiguration        OidcConfiguration?
  isActive                 Boolean                   @default(true)
  ssoEnabled               Boolean                   @default(false)
  ssoProvider              SsoProvider               @default(NONE)
  customReports            CustomReport[]
  crmConnections           CrmConnection[]
  crmContacts              CrmContact[]
  crmActivities            CrmActivity[]
  customerUsers            CustomerUser[]
  mediaAssets              MediaAsset[]
  assetFolders             AssetFolder[]
  assetTags                AssetTag[]
  accountSubscription      AccountSubscription?
  referralCode             ReferralCode?
  repurposeProposals       RepurposeProposal[]
  trendRadarResults        TrendRadarResult[]
  gatewayProvider          GatewayProvider           @default(STRIPE)
  gatewayCustomerId        String?
  pendingGatewayProvider   GatewayProvider?
  pendingGatewaySwitch     Boolean                   @default(false)
  gatewaySwitchAt          DateTime?                 @db.Timestamptz(6)
  gatewaySwitchEvents      GatewaySwitchEvent[]
  billingEvents            BillingEvent[]
  invoices                 Invoice[]
  dsarRequests             DsarRequest[]
  accountCredentials       AccountCredential[]
  aiTokenUsage             AiTokenUsage[]
  onboarding               AccountOnboarding?
  samlSessions             SamlSession[]
  referralsReceived        Referral[]                @relation("ReferredAccount")

  @@index([isOnTrial, trialEndDate], where: { deletedAt: null })
  @@index([nextBillingDate], where: { deletedAt: null })
  @@index([deletedAt])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  level       Int      @default(1)
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  permissions RolePermission[]
  users       AdminUser[]

  @@index([isActive])
}

model RolePermission {
  id         String   @id @default(cuid())
  roleId     String
  permission String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([roleId])
}

model AdminUser {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String
  name                  String
  roleId                String
  role                  Role      @relation(fields: [roleId], references: [id])
  isActive              Boolean   @default(true)
  emailVerified         Boolean   @default(false)
  lastLoginAt           DateTime? @db.Timestamptz(6)
  passwordResetToken    String?
  passwordResetExpires  DateTime? @db.Timestamptz(6)
  mfaEnabled            Boolean   @default(false)
  mfaSecret             String?
  passwordHashAlgo      String    @default("argon2id")
  passwordChangedAt     DateTime  @default(now()) @db.Timestamptz(6)
  passwordHistory       String[]  @default([])
  mustChangePassword    Boolean   @default(false)
  mfaBackupCodes        String[]  @default([])
  mfaBackupUsedAt       Json?     @default("{}")
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime? @db.Timestamptz(6)
  lockReason            String?
  maxConcurrentSessions Int       @default(3)
  timezone              String?   @default("UTC")
  locale                String?   @default("en")
  department            String?
  team                  String?
  avatarUrl             String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  // Relationships
  sessions      AdminSession[]
  auditLogs     AuditLog[]            @relation("PerformedBy")
  permissions   AdminUserPermission[]
  roleHistory   AdminRoleHistory[]
  loginAttempts AdminLoginAttempt[]
  // @@index([createdAt]) - REMOVED: Admin users rarely queried by creation date alone

  // @@index([email]) - REMOVED: Already unique indexed
  @@index([roleId, isActive])
  @@index([lastLoginAt])
  @@index([failedLoginAttempts, lockedUntil])
  @@index([passwordChangedAt])
}

model AdminSession {
  id String @id @default(uuid())
  userId String
  // SHA-256 hex digest of the refresh JWT. Plaintext token only exists in
  // the user's cookie / Authorization header; lookups hash the incoming
  // value and compare against this column. Same canonical pattern as
  // ApiKey.keyHash — protects against DB exfiltration leaking live tokens.
  refreshTokenHash String   @unique
  ipAddress        String?
  userAgent        String?
  isActive         Boolean  @default(true)
  expiresAt        DateTime @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  csrfToken        String   @unique @default(uuid())
  deviceId         String?
  deviceName       String?
  location         Json?
  lastActivityAt   DateTime @default(now()) @db.Timestamptz(6)
  revokedBy        String?
  revokeReason     String?

  // Relationships
  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([isActive, expiresAt])
  @@index([deviceId])
  @@index([lastActivityAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String? // Nullable for system actions
  action     String // e.g., "LOGIN", "CREATE_PROJECT", "DELETE_USER"
  resource   String? // e.g., "Project", "Account", "AdminUser"
  resourceId String? // ID of the affected resource
  details    Json? // Additional context
  ipAddress  String?
  userAgent  String?
  success    Boolean  @default(true)
  error      String? // Error message if success = false
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  // Relationships
  user AdminUser? @relation("PerformedBy", fields: [userId], references: [id], onDelete: SetNull)
  // @@index([createdAt]) - REMOVED: Covered by composites above

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resource, resourceId])
  @@index([success, createdAt])
}

model SecretRotationLog {
  id             String   @id @default(uuid())
  secretCategory String
  secretName     String
  rotatedAt      DateTime @db.Timestamptz(6)
  rotatedBy      String?
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([secretName, rotatedAt(sort: Desc)])
  @@index([secretCategory])
}

model AdminUserPermission {
  id         String    @id @default(uuid())
  userId     String
  resource   String
  action     String
  scope      String?   @default("*")
  conditions Json?
  grantedBy  String?
  grantedAt  DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime? @db.Timestamptz(6)
  isActive   Boolean   @default(true)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, action, scope])
  @@index([userId, isActive])
  @@index([resource, action])
  @@index([expiresAt])
  @@index([grantedAt])
}

model AdminRoleHistory {
  id             String    @id @default(uuid())
  userId         String
  oldRole        String
  newRole        String
  reason         String?
  changedBy      String?
  changedAt      DateTime  @default(now()) @db.Timestamptz(6)
  effectiveFrom  DateTime  @default(now()) @db.Timestamptz(6)
  effectiveUntil DateTime? @db.Timestamptz(6)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, changedAt])
  @@index([changedBy])
  @@index([effectiveFrom, effectiveUntil])
}

model TeamMember {
  id                String    @id @default(uuid())
  accountId         String
  email             String
  name              String
  role              TeamRole  @default(MEMBER)
  isActive          Boolean   @default(true)
  invitedBy         String?
  inviteToken       String?   @unique
  inviteTokenExpiry DateTime? @db.Timestamptz(6)
  joinedAt          DateTime  @default(now()) @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  account                  Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projectMemberships       ProjectMember[]
  notifications            Notification[]
  submittedApprovals       ApprovalRequest[]        @relation("ApprovalSubmitter")
  reviews                  ApprovalReview[]
  comments                 PostComment[]
  assignedMessages         SocialMessage[]          @relation("MessageAssignee")
  outboundReplies          SocialOutboundReply[]
  resolvedConversations    SocialConversation[]     @relation("ConversationResolver")
  conversationNotes        ConversationNote[]       @relation("NoteAuthor")
  assignedTasks            Task[]                   @relation("TaskAssignee")
  createdTasks             Task[]                   @relation("TaskCreator")
  notificationPreferences  NotificationPreference[]
  approvalLevelAssignments ApprovalWorkflowLevel[]
  customReportsCreated     CustomReport[]           @relation("CustomReportCreator")

  @@unique([accountId, email])
  @@index([accountId, isActive])
  @@index([email])
}

model CustomerUser {
  id                String    @id @default(cuid())
  accountId         String
  email             String
  passwordHash      String
  firstName         String
  lastName          String
  role              TeamRole  @default(MEMBER)
  isActive          Boolean   @default(true)
  isEmailVerified   Boolean   @default(false)
  emailVerifyToken  String?   @unique
  emailVerifyExpiry DateTime? @db.Timestamptz(6)
  resetToken        String?   @unique
  resetTokenExpiry  DateTime? @db.Timestamptz(6)
  mfaEnabled        Boolean   @default(false)
  mfaSecret         String?
  lastLoginAt       DateTime? @db.Timestamptz(6)
  avatarUrl         String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime? @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, email])
  @@index([accountId], where: { deletedAt: null })
  @@index([email], where: { deletedAt: null })
}

model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String
  memberId    String
  permissions String[] @default(["READ", "WRITE"])
  assignedAt  DateTime @default(now()) @db.Timestamptz(6)

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([memberId])
}

enum TeamRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

model Notification {
  id           String           @id @default(uuid())
  recipientId  String
  type         NotificationType
  title        String
  body         String
  resourceType String?
  resourceId   String?
  actorId      String?
  actorName    String?
  isRead       Boolean          @default(false)
  readAt       DateTime?        @db.Timestamptz(6)
  metadata     Json?
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)

  recipient TeamMember @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt])
  @@index([recipientId, createdAt])
}

model NotificationPreference {
  id        String           @id @default(uuid())
  memberId  String
  type      NotificationType
  enabled   Boolean          @default(true)
  updatedAt DateTime         @updatedAt @db.Timestamptz(6)

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, type])
}

enum NotificationType {
  APPROVAL_REQUESTED
  POST_APPROVED
  POST_REJECTED
  COMMENT_ADDED
  COMMENT_REPLY
  MENTION
  TEAM_INVITE
  INBOX_MESSAGE_RECEIVED
  INBOX_MENTION_RECEIVED
}

model ApprovalWorkflow {
  id          String   @id @default(cuid())
  accountId   String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  levels   ApprovalWorkflowLevel[]
  requests ApprovalRequest[]
  account  Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, name])
  @@index([accountId])
}

model ApprovalWorkflowLevel {
  id         String   @id @default(cuid())
  workflowId String
  order      Int
  role       String?
  assigneeId String?
  requireAll Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  assignee TeamMember?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([workflowId, order])
  @@index([workflowId])
}

model ApprovalRequest {
  id           String         @id @default(uuid())
  postId       String
  submitterId  String
  workflowId   String?
  currentLevel Int            @default(1)
  totalLevels  Int            @default(1)
  status       ApprovalStatus @default(PENDING)
  comment      String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)

  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  submitter TeamMember        @relation("ApprovalSubmitter", fields: [submitterId], references: [id])
  workflow  ApprovalWorkflow? @relation(fields: [workflowId], references: [id])
  reviews   ApprovalReview[]

  @@index([postId, status])
  @@index([submitterId, createdAt])
  @@index([workflowId])
}

model ApprovalReview {
  id         String         @id @default(uuid())
  requestId  String
  reviewerId String
  decision   ReviewDecision
  comment    String?
  level      Int            @default(1)
  reviewedAt DateTime       @default(now()) @db.Timestamptz(6)

  request  ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewer TeamMember      @relation(fields: [reviewerId], references: [id])

  @@index([requestId])
  @@index([reviewerId])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid())
  accountId   String
  projectId   String?
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(OPEN)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  createdById String
  dueDate     DateTime?    @db.Timestamptz(6)
  completedAt DateTime?    @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?    @db.Timestamptz(6)
  postId      String?

  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project   Project?    @relation(fields: [projectId], references: [id])
  assignee  TeamMember? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy TeamMember  @relation("TaskCreator", fields: [createdById], references: [id])
  post      Post?       @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([accountId], where: { deletedAt: null })
  @@index([assigneeId], where: { deletedAt: null })
  @@index([status], where: { deletedAt: null })
  @@index([createdById], where: { deletedAt: null })
}

model PostComment {
  id        String    @id @default(uuid())
  postId    String
  authorId  String
  parentId  String?
  body      String
  mentions  String[]  @default([])
  isEdited  Boolean   @default(false)
  editedAt  DateTime? @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  TeamMember    @relation(fields: [authorId], references: [id])
  parent  PostComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies PostComment[] @relation("CommentReplies")

  @@index([postId, deletedAt, createdAt])
  @@index([parentId], where: { deletedAt: null })
  @@index([authorId], where: { deletedAt: null })
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model AdminLoginAttempt {
  id              String   @id @default(uuid())
  userId          String?
  email           String
  success         Boolean  @default(false)
  failureReason   String?
  mfaAttempted    Boolean  @default(false)
  mfaSuccess      Boolean?
  ipAddress       String?
  userAgent       String?
  deviceId        String?
  location        Json?
  isBlocked       Boolean  @default(false)
  blockReason     String?
  threatScore     Int?     @default(0)
  requiresCaptcha Boolean  @default(false)
  attemptedAt     DateTime @default(now()) @db.Timestamptz(6)

  user AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@index([userId, attemptedAt])
  @@index([success, attemptedAt])
  @@index([isBlocked, threatScore])
  @@index([deviceId])
}

model Project {
  id                          String                       @id @default(uuid())
  name                        String
  locale                      String                       @default("es")
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(6)
  accountId                   String
  isInCrisisMode              Boolean                      @default(false)
  crisisStartedAt             DateTime?                    @db.Timestamptz(6)
  crisisReason                String?
  crisisModeHistory           Json?                        @default("[]")
  deletedAt                   DateTime?                    @db.Timestamptz(6)
  channels                    Channel[]
  posts                       Post[]
  account                     Account                      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  providerConnections         ProviderConnection[]
  contentTemplates            ContentTemplate[]
  publishingQueue             PublishingQueue[]
  instagramStoryProjects      InstagramStoryProject[]
  videoProcessingJobs         VideoProcessingJob[]
  instagramAnalytics          InstagramAnalytics[]
  schedulingRules             SchedulingRule[]
  webhookEvents               WebhookEvent[]
  webhookSubscriptions        WebhookSubscription[]
  templates                   Template[]
  trackedLinks                TrackedLink[]
  members                     ProjectMember[]
  socialMessages              SocialMessage[]
  socialConversations         SocialConversation[]
  campaigns                   Campaign[]
  scheduledReports            ScheduledReport[]
  externalNotificationConfigs ExternalNotificationConfig[]
  generatedImages             GeneratedImage[]
  recurringPosts              RecurringPost[]
  mediaAssets                 MediaAsset[]
  tasks                       Task[]
  customReports               CustomReport[]               @relation("CustomReportProject")

  @@unique([accountId, name])
  @@index([accountId], where: { deletedAt: null })
  @@index([createdAt], where: { deletedAt: null })
  @@index([locale], where: { deletedAt: null })
  @@index([isInCrisisMode], where: { deletedAt: null })
  @@index([deletedAt])
}

model Post {
  id                        String                    @id @default(uuid())
  projectId                 String
  status                    String                    @default("DRAFT")
  scheduledAt               DateTime?                 @db.Timestamptz(6)
  publishedAt               DateTime?                 @db.Timestamptz(6)
  createdAt                 DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                  @updatedAt @db.Timestamptz(6)
  project                   Project                   @relation(fields: [projectId], references: [id])
  contents                  PostContent[]
  media                     PostMedia[]
  thread                    Thread?
  publishingQueue           PublishingQueue[]
  contentVersions           ContentVersion[]
  webhookEvents             WebhookEvent[]
  analytics                 Analytics[]
  publishLogs               PublishLog[]
  approvalRequests          ApprovalRequest[]
  comments                  PostComment[]
  socialMessages            SocialMessage[]
  campaignPosts             CampaignPost[]
  firstComment              FirstComment?
  repurposeProposals        RepurposeProposal[]       @relation("RepurposeSource")
  repurposedVariants        RepurposeVariant[]        @relation("RepurposedPost")
  tasks                     Task[]
  analyticsDailySummaries   AnalyticsDailySummary[]
  analyticsMonthlySummaries AnalyticsMonthlySummary[]
  recurringInstances        RecurringPost[]           @relation("RecurringTemplatePost")
  deletedAt                 DateTime?                 @db.Timestamptz(6)

  @@index([scheduledAt], where: { deletedAt: null })
  @@index([projectId, status], where: { deletedAt: null })
  @@index([projectId, createdAt], where: { deletedAt: null })
  @@index([projectId, publishedAt], where: { deletedAt: null })
  @@index([projectId, scheduledAt, status], where: { deletedAt: null })
  @@index([deletedAt])
}

model PostContent {
  id        String   @id @default(uuid())
  postId    String
  locale    String
  title     String?
  summary   String?
  body      String
  tags      String[]
  revision  Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([postId, locale, revision])
  // @@index([postId]) - REMOVED: Covered by [postId, locale] and unique constraint
  // @@index([locale]) - REMOVED: Low cardinality (only 5-10 locales)
  @@index([tags])
  @@index([postId, locale])
}

model PostMedia {
  id                  String               @id @default(uuid())
  postId              String
  url                 String
  width               Int?
  height              Int?
  durationMs          Int?
  alt                 String?
  hash                String?
  tags                String[]             @default([])
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  type                MediaKind
  post                Post                 @relation(fields: [postId], references: [id])
  instagramStories    InstagramStory[]
  videoProcessingJobs VideoProcessingJob[]

  @@index([postId])
  @@index([type])
  @@index([hash])
  @@index([createdAt])
}

model Channel {
  id        String   @id @default(uuid())
  projectId String
  provider  Provider
  handle    String
  // Provider-side account ID (Facebook page_id, Instagram account_id, X user_id, etc.).
  // Non-secret — kept as a queryable column so webhook processors can resolve a
  // channel by provider-supplied entity ID without needing to decrypt the
  // credentials envelope. Populated alongside credentials at OAuth-callback time.
  providerAccountId String?
  // OAuth tokens + per-provider metadata, wrapped via EncryptionService
  // (AES-256-GCM). Plaintext only exists in-memory at request time —
  // ChannelService decrypts on read, encrypts on write. Stored as a
  // JSON-serialised envelope: the original credentials object is
  // canonicalised, encrypted, and the ciphertext + IV + auth tag live
  // in separate columns alongside the key version that wrapped them.
  credentialsCiphertext String
  credentialsIv         String
  credentialsAuthTag    String
  credentialsKeyVersion Int                       @default(1)
  isPrimary                 Boolean                   @default(false)
  createdAt                 DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                  @updatedAt @db.Timestamptz(6)
  project                   Project                   @relation(fields: [projectId], references: [id])
  publishLogs               PublishLog[]
  analytics                 Analytics[]
