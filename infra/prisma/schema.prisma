// Outbox Pattern for reliable event publishing

model OutboxEvent {
  id            String    @id @default(uuid())
  eventType     String
  aggregateId   String
  aggregateType String
  payload       Json
  version       Int       @default(1)
  occurredAt    DateTime
  publishedAt   DateTime?
  retryCount    Int       @default(0)
  maxRetries    Int       @default(5)
  nextRetryAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([publishedAt, nextRetryAt])
  @@index([aggregateId, aggregateType])
  @@index([eventType])
  @@index([createdAt])
}

// Saga Pattern - durable saga instance persistence

model SagaInstance {
  id                  String    @id
  definitionId        String
  status              String // PENDING | RUNNING | COMPLETED | FAILED | COMPENSATING | COMPENSATED
  currentStep         Int       @default(0)
  context             Json
  stepResults         Json      @default("[]")
  compensationResults Json      @default("[]")
  retryCount          Int       @default(0)
  error               String?
  accountId           String?
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  updatedAt           DateTime  @updatedAt
  createdAt           DateTime  @default(now())

  @@index([status, startedAt])
  @@index([definitionId, status])
  @@index([accountId, status])
  @@index([completedAt])
}

// Social Inbox - Phase 2

enum SocialMessageType {
  COMMENT
  MENTION
  DIRECT_MESSAGE
  REPLY
}

enum SocialMessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

enum OutboundReplyStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model SocialMessage {
  id                String              @id @default(uuid())
  accountId         String
  projectId         String
  channelId         String
  conversationId    String?
  provider          Provider
  providerMessageId String
  providerParentId  String?
  messageType       SocialMessageType
  authorName        String
  authorHandle      String?
  authorAvatarUrl   String?
  authorProviderId  String
  body              String
  mediaUrls         String[]            @default([])
  webhookEventId    String?             @unique
  relatedPostId     String?
  status            SocialMessageStatus @default(UNREAD)
  assigneeId        String?
  isArchived        Boolean             @default(false)
  priority          MessagePriority     @default(NORMAL)
  suggestedReplies  String[]            @default([])
  crmContactId      String?
  aiProcessedAt     DateTime?
  sentimentScore    Decimal?            @db.Decimal(3, 2)
  providerCreatedAt DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  account         Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel         Channel              @relation(fields: [channelId], references: [id])
  conversation    SocialConversation?  @relation(fields: [conversationId], references: [id])
  webhookEvent    WebhookEvent?        @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)
  relatedPost     Post?                @relation(fields: [relatedPostId], references: [id], onDelete: SetNull)
  assignee        TeamMember?          @relation("MessageAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  outboundReplies SocialOutboundReply[]

  @@unique([provider, providerMessageId])
  @@index([accountId, projectId, status])
  @@index([conversationId])
  @@index([channelId, messageType])
  @@index([assigneeId, status])
  @@index([providerCreatedAt])
  @@index([relatedPostId])
}

model SocialConversation {
  id                    String    @id @default(uuid())
  accountId             String
  projectId             String
  channelId             String
  provider              Provider
  subject               String?
  participantCount      Int       @default(1)
  messageCount          Int       @default(0)
  lastMessageAt         DateTime
  isResolved            Boolean   @default(false)
  resolvedAt            DateTime?
  resolvedById          String?
  rootProviderMessageId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  account    Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel    Channel         @relation(fields: [channelId], references: [id])
  messages   SocialMessage[]
  notes      ConversationNote[]
  resolvedBy TeamMember?     @relation("ConversationResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([accountId, projectId, isResolved])
  @@index([channelId, provider])
  @@index([lastMessageAt])
}

model ConversationNote {
  id             String    @id @default(cuid())
  conversationId String
  authorId       String
  body           String    @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  conversation   SocialConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         TeamMember         @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([conversationId])
  @@index([authorId])
}

model SocialOutboundReply {
  id              String              @id @default(uuid())
  socialMessageId String
  authorId        String
  body            String
  providerReplyId String?
  status          OutboundReplyStatus @default(PENDING)
  errorMessage    String?
  sentAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  socialMessage SocialMessage @relation(fields: [socialMessageId], references: [id], onDelete: Cascade)
  author        TeamMember    @relation(fields: [authorId], references: [id])

  @@index([socialMessageId])
  @@index([authorId])
  @@index([status])
}

