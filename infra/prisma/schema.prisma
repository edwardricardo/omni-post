  @@index([queueId])
  @@index([changeType])
  @@index([createdBy])
  @@index([approvedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([postId, createdAt]) // ✅ Phase 4: For version history queries sorted by creation
