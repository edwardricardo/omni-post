// ── CRM Integration ─────────────────────────────────────────────────────────

enum CrmPlatform {
  HUBSPOT
  SALESFORCE
}

enum CrmActivityType {
  POST_PUBLISHED
  POST_SCHEDULED
  CAMPAIGN_CREATED
  CAMPAIGN_COMPLETED
  APPROVAL_APPROVED
}

enum SyncStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

model CrmConnection {
  id             String      @id @default(cuid())
  accountId      String
  platform       CrmPlatform
  isActive       Boolean     @default(true)
  accessToken    String      @db.Text
  refreshToken   String?     @db.Text
