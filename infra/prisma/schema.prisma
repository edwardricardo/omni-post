generator client {
  provider = "prisma-client"
  output   = "./generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  name                   String
  subscription           SubscriptionTier        @default(BASIC)
  maxProjects            Int                     @default(1)
  isOnTrial              Boolean                 @default(true)
  trialStartDate         DateTime                @default(now())
  trialEndDate           DateTime?
  autoRenewal            Boolean                 @default(false)
  billingCycle           String                  @default("monthly") // "monthly" or "yearly"
  lastBillingDate        DateTime?
  nextBillingDate        DateTime?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  projects               Project[]
  apiKeys                ApiKey[]
  providerConnections    ProviderConnection[]
  contentTemplates       ContentTemplate[]
  publishingQueue        PublishingQueue[]
  instagramStoryProjects InstagramStoryProject[]
  videoProcessingJobs    VideoProcessingJob[]
  instagramAnalytics     InstagramAnalytics[]
  schedulingRules        SchedulingRule[]
  webhookEvents          WebhookEvent[]
  webhookSubscriptions   WebhookSubscription[]
  templates              Template[]
  deletedAt              DateTime?
  teamMembers            TeamMember[]
  socialMessages         SocialMessage[]
  socialConversations    SocialConversation[]
  // @@index([subscription]) - REMOVED: Low cardinality (only 3 values)
  // @@index([createdAt]) - REMOVED: Rarely queried alone
  // @@index([updatedAt]) - REMOVED: Rarely queried alone

  // @@index([email]) - REMOVED: Already unique indexed
  @@index([isOnTrial, trialEndDate])
  @@index([nextBillingDate])
  @@index([deletedAt])
}

model AdminUser {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  name                 String
  role                 AdminRole @default(ADMIN)
  isActive             Boolean   @default(true)
  emailVerified        Boolean   @default(false)
  lastLoginAt          DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  mfaEnabled            Boolean   @default(false)
  mfaSecret             String?
  passwordHashAlgo      String    @default("argon2id")
  passwordChangedAt     DateTime  @default(now())
  passwordHistory       String[]  @default([])
  mustChangePassword    Boolean   @default(false)
  mfaBackupCodes        String[]  @default([])
  mfaBackupUsedAt       Json?     @default("{}")
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  lockReason            String?
  maxConcurrentSessions Int       @default(3)
  timezone              String?   @default("UTC")
  locale                String?   @default("en")
  department            String?
  team                  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relationships
  sessions      AdminSession[]
  auditLogs     AuditLog[]              @relation("PerformedBy")
  permissions   AdminUserPermission[]
  roleHistory   AdminRoleHistory[]
  loginAttempts AdminLoginAttempt[]
  // @@index([createdAt]) - REMOVED: Admin users rarely queried by creation date alone

  // @@index([email]) - REMOVED: Already unique indexed
  @@index([role, isActive])
  @@index([lastLoginAt])
  @@index([failedLoginAttempts, lockedUntil])
  @@index([passwordChangedAt])
}

model AdminSession {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique
  accessToken  String? // Optional - can store for tracking
  ipAddress    String?
  userAgent    String?
  isActive     Boolean   @default(true)
  expiresAt    DateTime
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  csrfToken      String    @unique @default(uuid())
  deviceId       String?
  deviceName     String?
  location       Json?
  lastActivityAt DateTime  @default(now())
  revokedBy      String?
  revokeReason   String?

  // Relationships
  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  // @@index([refreshToken]) - REMOVED: Already unique indexed
  // @@index([expiresAt]) - REMOVED: Covered by [isActive, expiresAt]
  // @@index([createdAt]) - REMOVED: Low value for sessions
  @@index([isActive, expiresAt])
  @@index([deviceId])
  @@index([lastActivityAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String? // Nullable for system actions
  action     String // e.g., "LOGIN", "CREATE_PROJECT", "DELETE_USER"
  resource   String? // e.g., "Project", "Account", "AdminUser"
  resourceId String? // ID of the affected resource
  details    Json? // Additional context
  ipAddress  String?
  userAgent  String?
  success    Boolean  @default(true)
  error      String? // Error message if success = false
  createdAt  DateTime @default(now())

  // Relationships
  user AdminUser? @relation("PerformedBy", fields: [userId], references: [id], onDelete: SetNull)
  // @@index([createdAt]) - REMOVED: Covered by composites above

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resource, resourceId])
  @@index([success, createdAt])
}

model AdminUserPermission {
  id         String    @id @default(uuid())
  userId     String
  resource   String
  action     String
  scope      String?   @default("*")
  conditions Json?
  grantedBy  String?
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime?
  isActive   Boolean   @default(true)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, action, scope])
  @@index([userId, isActive])
  @@index([resource, action])
  @@index([expiresAt])
  @@index([grantedAt])
}

model AdminRoleHistory {
  id             String    @id @default(uuid())
  userId         String
  oldRole        String
  newRole        String
  reason         String?
  changedBy      String?
  changedAt      DateTime  @default(now())
  effectiveFrom  DateTime  @default(now())
  effectiveUntil DateTime?

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, changedAt])
  @@index([changedBy])
  @@index([effectiveFrom, effectiveUntil])
}

model TeamMember {
  id        String   @id @default(uuid())
  accountId String
  email     String
  name      String
  role      TeamRole @default(MEMBER)
  isActive  Boolean  @default(true)
  invitedBy String?
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account            Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projectMemberships ProjectMember[]
  notifications      Notification[]
  submittedApprovals ApprovalRequest[] @relation("ApprovalSubmitter")
  reviews            ApprovalReview[]
  comments           PostComment[]
  assignedMessages   SocialMessage[]     @relation("MessageAssignee")
  outboundReplies    SocialOutboundReply[]
  resolvedConversations SocialConversation[] @relation("ConversationResolver")

  @@unique([accountId, email])
  @@index([accountId, isActive])
  @@index([email])
}

model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String
  memberId    String
  permissions String[] @default(["READ", "WRITE"])
  assignedAt  DateTime @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([memberId])
}

enum TeamRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

model Notification {
  id           String           @id @default(uuid())
  recipientId  String
  type         NotificationType
  title        String
  body         String
  resourceType String?
  resourceId   String?
  actorId      String?
  actorName    String?
  isRead       Boolean          @default(false)
  readAt       DateTime?
  metadata     Json?
  createdAt    DateTime         @default(now())

  recipient TeamMember @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt])
  @@index([recipientId, createdAt])
}

model NotificationPreference {
  id        String           @id @default(uuid())
  memberId  String
  type      NotificationType
  enabled   Boolean          @default(true)
  updatedAt DateTime         @updatedAt

  @@unique([memberId, type])
}

enum NotificationType {
  APPROVAL_REQUESTED
  POST_APPROVED
  POST_REJECTED
  COMMENT_ADDED
  COMMENT_REPLY
  MENTION
  TEAM_INVITE
  INBOX_MESSAGE_RECEIVED
  INBOX_MENTION_RECEIVED
}

model ApprovalRequest {
  id          String         @id @default(uuid())
  postId      String
  submitterId String
  status      ApprovalStatus @default(PENDING)
  comment     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  post      Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  submitter TeamMember       @relation("ApprovalSubmitter", fields: [submitterId], references: [id])
  reviews   ApprovalReview[]

  @@index([postId, status])
  @@index([submitterId, createdAt])
}

model ApprovalReview {
  id         String         @id @default(uuid())
  requestId  String
  reviewerId String
  decision   ReviewDecision
  comment    String?
  reviewedAt DateTime       @default(now())

  request  ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewer TeamMember      @relation(fields: [reviewerId], references: [id])

  @@index([requestId])
  @@index([reviewerId])
}

model PostComment {
  id        String    @id @default(uuid())
  postId    String
  authorId  String
  parentId  String?
  body      String
  mentions  String[]  @default([])
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  TeamMember    @relation(fields: [authorId], references: [id])
  parent  PostComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies PostComment[] @relation("CommentReplies")

  @@index([postId, deletedAt, createdAt])
  @@index([parentId])
  @@index([authorId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model AdminLoginAttempt {
  id              String    @id @default(uuid())
  userId          String?
  email           String
  success         Boolean   @default(false)
  failureReason   String?
  mfaAttempted    Boolean   @default(false)
  mfaSuccess      Boolean?
  ipAddress       String?
  userAgent       String?
  deviceId        String?
  location        Json?
  isBlocked       Boolean   @default(false)
  blockReason     String?
  threatScore     Int?      @default(0)
  requiresCaptcha Boolean   @default(false)
  attemptedAt     DateTime  @default(now())

  user AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@index([userId, attemptedAt])
  @@index([success, attemptedAt])
  @@index([isBlocked, threatScore])
  @@index([deviceId])
}

model Project {
  id                     String                  @id @default(uuid())
  name                   String
  locale                 String                  @default("es")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  accountId              String
  isInCrisisMode         Boolean                 @default(false)
  crisisStartedAt        DateTime?
  crisisReason           String?
  crisisModeHistory      Json?                   @default("[]")
  deletedAt              DateTime?
  channels               Channel[]
  posts                  Post[]
  account                Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  providerConnections    ProviderConnection[]
  contentTemplates       ContentTemplate[]
  publishingQueue        PublishingQueue[]
  instagramStoryProjects InstagramStoryProject[]
  videoProcessingJobs    VideoProcessingJob[]
  instagramAnalytics     InstagramAnalytics[]
  schedulingRules        SchedulingRule[]
  webhookEvents          WebhookEvent[]
  webhookSubscriptions   WebhookSubscription[]
  templates              Template[]
  trackedLinks           TrackedLink[]
  members                ProjectMember[]
  socialMessages         SocialMessage[]
  socialConversations    SocialConversation[]
  campaigns              Campaign[]
  scheduledReports       ScheduledReport[]

  @@unique([accountId, name])
  @@index([accountId])
  @@index([createdAt])
  @@index([locale])
  @@index([isInCrisisMode])
  @@index([deletedAt])
}

model Post {
  id              String            @id @default(uuid())
  projectId       String
  status          String            @default("DRAFT")
  scheduledAt     DateTime?
  publishedAt     DateTime?         // ✅ Phase 1: Added missing field referenced in code
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  project         Project           @relation(fields: [projectId], references: [id])
  contents        PostContent[]
  media           PostMedia[]
  thread          Thread?
  publishingQueue PublishingQueue[]
  contentVersions ContentVersion[]
  webhookEvents   WebhookEvent[]
  analytics       Analytics[]       // ✅ Phase 1: Added relationship (fixes N+1 queries)
  publishLogs     PublishLog[]      // ✅ Phase 1: Added relationship (fixes N+1 queries)
  approvalRequests ApprovalRequest[]
  comments        PostComment[]
  socialMessages  SocialMessage[]
  campaignPosts   CampaignPost[]
  deletedAt       DateTime?

  // @@index([projectId]) - REMOVED: Covered by [projectId, status] and [projectId, createdAt]
  // @@index([status]) - REMOVED: Low cardinality (only 3-4 values)
  @@index([scheduledAt])
  // @@index([createdAt]) - REMOVED: Covered by [projectId, createdAt]
  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([projectId, publishedAt]) // ✅ Phase 1: Added index for published posts queries
  @@index([projectId, scheduledAt, status]) // ✅ Phase 4: For upcoming scheduled posts queries
  @@index([deletedAt])
}

model PostContent {
  id        String   @id @default(uuid())
  postId    String
  locale    String
  title     String?
  summary   String?
  body      String
  tags      String[]
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([postId, locale, revision])
  // @@index([postId]) - REMOVED: Covered by [postId, locale] and unique constraint
  // @@index([locale]) - REMOVED: Low cardinality (only 5-10 locales)
  @@index([tags])
  @@index([postId, locale])
}

model PostMedia {
  id                  String               @id @default(uuid())
  postId              String
  url                 String
  width               Int?
  height              Int?
  durationMs          Int?
  alt                 String?
  hash                String?
  createdAt           DateTime             @default(now())
  type                MediaKind
  post                Post                 @relation(fields: [postId], references: [id])
  instagramStories    InstagramStory[]
  videoProcessingJobs VideoProcessingJob[]

  @@index([postId])
  @@index([type])
  @@index([hash])
  @@index([createdAt])
}

model Channel {
  id          String       @id @default(uuid())
  projectId   String
  provider    Provider
  handle      String
  credentials Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id])
  publishLogs PublishLog[] // ✅ Phase 1: Added relationship (fixes N+1 queries)
  analytics   Analytics[]  // ✅ Phase 1: Added relationship (fixes N+1 queries)
  socialMessages   SocialMessage[]
  socialConversations SocialConversation[]
  deletedAt   DateTime?

  @@index([projectId])
  @@index([provider])
  @@index([projectId, provider])
  @@index([createdAt])
  @@index([deletedAt])
}

model TrackedLink {
  id          String      @id @default(uuid())
  projectId   String
  originalUrl String
  shortCode   String      @unique
  vanitySlug  String?
  clicks      Int         @default(0)
  isActive    Boolean     @default(true)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  campaignId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  linkClicks  LinkClick[]

  @@index([projectId, isActive])
  @@index([shortCode])
  @@index([vanitySlug])
  @@index([createdAt])
  @@index([clicks])
}

model LinkClick {
  id            String      @id @default(uuid())
  trackedLinkId String
  timestamp     DateTime    @default(now())
  referrer      String?
  userAgent     String?
  ipAddress     String?
  country       String?
  city          String?

  trackedLink   TrackedLink @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([trackedLinkId, timestamp])
  @@index([country])
  @@index([timestamp])
}

model PublishLog {
  id        String    @id @default(uuid())
  postId    String?
  provider  Provider
  channelId String
  payload   Json
  dedupeKey String    @unique
  createdAt DateTime  @default(now())
  status    LogStatus
  post      Post?     @relation(fields: [postId], references: [id], onDelete: SetNull) // ✅ Phase 1: Added relationship
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade) // ✅ Phase 1: Added relationship
  // @@index([createdAt]) - REMOVED: Covered by composite indexes above

  @@index([channelId, status, createdAt])
  @@index([postId, provider, createdAt])
  @@index([status, createdAt])
  @@index([provider, createdAt])
  @@index([postId, createdAt]) // ✅ Phase 4: For post publish history queries
}

model Analytics {
  id         String   @id @default(uuid())
  postId     String?
  channelId  String
  provider   Provider
  views      Int?     @default(0)
  likes      Int?     @default(0)
  comments   Int?     @default(0)
  shares     Int?     @default(0)
  capturedAt DateTime @default(now())
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade) // ✅ Phase 1: Added relationship (CRITICAL for N+1 fix)
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade) // ✅ Phase 1: Added relationship

  @@index([postId, provider, capturedAt])
  @@index([channelId, capturedAt])
  @@index([provider, capturedAt])
  // @@index([capturedAt]) - REMOVED: Covered by composite indexes above
  // @@index([postId, capturedAt]) - REMOVED: Covered by [postId, provider, capturedAt]
  @@index([channelId, provider, capturedAt])
}

model Thread {
  id        String         @id @default(uuid())
  postId    String         @unique
  strategy  ThreadStrategy @default(AUTO)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  post      Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  tweets    Tweet[]

  // @@index([postId]) - REMOVED: Already unique indexed
  @@index([strategy])
  @@index([createdAt])
  @@index([updatedAt])
}

model Tweet {
  id             String      @id @default(uuid())
  threadId       String
  sequenceNumber Int
  content        String
  media          Json?
  tweetId        String?
  parentTweetId  String?
  status         TweetStatus @default(PENDING)
  publishedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  thread         Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  // @@index([threadId, sequenceNumber]) - REMOVED: Duplicate of unique constraint

  @@unique([threadId, sequenceNumber])
  @@index([threadId, status])
  @@index([tweetId])
  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
}

model ApiKey {
  id               String    @id @default(uuid())
  accountId        String
  name             String
  keyHash          String    @unique
  prefix           String
  permissions      String[]  @default(["read"])
  rateLimit        Int       @default(1000)
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  isActive         Boolean   @default(true)
  rotationSchedule String? // cron expression
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relationships
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, isActive])
  // @@index([keyHash]) - REMOVED: Already unique indexed
  @@index([expiresAt])
  @@index([lastUsedAt])
}

model ProviderConnection {
  id                String   @id @default(uuid())
  accountId         String
  projectId         String
  providerId        Provider
  providerName      String // e.g., "X", "Instagram"
  accountName       String? // e.g., "@username"
  providerAccountId String? // Provider-specific account ID (renamed to avoid conflict)
  profileImage      String?

  // Authentication data (encrypted)
  accessToken  String?
  refreshToken String?
  apiKey       String?
  apiSecret    String?
  tokenType    String? @default("Bearer")

  // Connection metadata
  connectedAt DateTime  @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  isVerified  Boolean   @default(false)

  // Capabilities and limits (cached from provider)
  capabilities Json // ProviderCapabilities
  limits       Json // ProviderLimits
  constraints  Json? // ProviderConstraints

  // Status and health
  status          ConnectionStatus @default(CONNECTED)
  lastHealthCheck DateTime?
  healthScore     Int?             @default(100)
  errorCount      Int              @default(0)
  lastError       String?
  lastErrorAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([accountId, projectId, providerId])
  @@index([accountId, isActive])
  @@index([projectId, isActive])
  @@index([providerId, status])
  @@index([expiresAt])
  @@index([lastUsedAt])
  @@index([healthScore])
  @@index([createdAt])
  @@index([updatedAt])
}

model ContentTemplate {
  id        String  @id @default(uuid())
  accountId String
  projectId String?

  // Template metadata
  name        String
  description String?
  category    String?
  tags        String[] @default([])

  // Template content
  content   Json // CanonicalPost structure
  variables Json? // Variable definitions and defaults

  // Provider-specific optimizations
  providerOptimizations Json? // Provider-specific content variations

  // Usage and performance
  usageCount  Int       @default(0)
  lastUsedAt  DateTime?
  performance Json? // Analytics data when used

  // Template settings
  isPublic Boolean @default(false)
  isActive Boolean @default(true)
  version  Int     @default(1)
  parentId String? // For template versioning

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  account         Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent          ContentTemplate?  @relation("TemplateVersions", fields: [parentId], references: [id])
  versions        ContentTemplate[] @relation("TemplateVersions")
  publishingQueue PublishingQueue[]
  contentVersions ContentVersion[]

  @@index([accountId, isActive])
  @@index([projectId, isActive])
  @@index([category])
  @@index([tags])
  @@index([usageCount])
  @@index([lastUsedAt])
  // @@index([createdAt]) - REMOVED: Rarely queried alone for templates
  // @@index([updatedAt]) - REMOVED: Rarely queried alone for templates
  @@index([parentId, version])
}

model PublishingQueue {
  id         String  @id @default(uuid())
  accountId  String
  projectId  String
  postId     String? // Reference to existing post
  templateId String? // Reference to template used

  // Content to publish
  content         Json // CanonicalPost or processed content
  originalContent Json? // Original content before adaptations

  // Publishing configuration
  providers          Provider[] // Target providers
  contentType        InstagramContentType? // Specific content type for Instagram
  scheduledAt        DateTime?
  timezone           String                @default("UTC")
  publishImmediately Boolean               @default(false)

  // Instagram-specific settings
  storyProjectId       String? // Reference to Instagram Story Project
  videoProcessingJobId String? // Reference to video processing job
  priority             QueuePriority @default(MEDIUM)

  // Optimization settings
  optimizeForEngagement Boolean @default(false)
  respectRateLimits     Boolean @default(true)
  autoRetry             Boolean @default(true)

  // Cross-platform settings
  adaptContent  Boolean @default(true)
  optimizeMedia Boolean @default(true)

  // Status and progress
  status      PublishingStatus @default(PENDING)
  progress    Int              @default(0) // 0-100
  startedAt   DateTime?
  completedAt DateTime?

  // Results and tracking
  results             Json? // PublishResult per provider
  totalProviders      Int   @default(0)
  successfulProviders Int   @default(0)
  failedProviders     Int   @default(0)

  // Error handling
  retryCount  Int       @default(0)
  maxRetries  Int       @default(3)
  lastError   String?
  lastErrorAt DateTime?

  // Dependencies and sequencing
  parentQueueId  String? // For threaded publishing
  sequenceNumber Int? // Order in sequence
  dependsOn      String[] @default([]) // Queue IDs this depends on

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  account            Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
