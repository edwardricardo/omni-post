// Webhook Event Models for Real-Time Integration

model WebhookEvent {
  id        String  @id @default(uuid())
  accountId String?
  projectId String?

  // Event identification
  provider  Provider // Source platform
  eventType WebhookEventType
  eventId   String // Provider's event ID (for deduplication)
  signature String // Webhook signature for verification

  // Event data
  payload        Json // Raw webhook payload
  headers        Json // Request headers
  normalizedData Json? // Processed/normalized event data

  // Processing status
  status    WebhookProcessingStatus @default(PENDING)
  verified  Boolean                 @default(false)
  processed Boolean                 @default(false)

  // Processing metadata
  retryCount     Int       @default(0)
  maxRetries     Int       @default(3)
  nextRetryAt    DateTime?
  lastError      String?
  processingTime Int? // Processing time in milliseconds

  // Related entities
  postId    String? // Related post if applicable
  channelId String? // Related channel if applicable

  // Timestamps
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  socialMessage SocialMessage?

  @@unique([provider, eventId]) // Prevent duplicate events
  @@index([provider, eventType])
  @@index([status, nextRetryAt])
  @@index([accountId, provider])
  @@index([receivedAt])
  @@index([processed, status])
  @@index([channelId, eventType])
}

model WebhookSubscription {
  id        String  @id @default(uuid())
  accountId String
  projectId String?

  // Subscription details
  provider   Provider
  webhookUrl String // Our webhook endpoint URL
  secretKey  String // Secret for signature verification
  isActive   Boolean  @default(true)

  // Provider-specific configuration
  subscriptionId String? // Provider's subscription ID
  verifyToken    String? // Facebook verification token
  eventTypes     WebhookEventType[] // Subscribed event types

  // Subscription metadata
  expiresAt    DateTime? // Subscription expiration
  lastVerified DateTime? // Last successful verification

  // Statistics
  eventsReceived  Int       @default(0)
  eventsProcessed Int       @default(0)
  lastEventAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([accountId, provider, projectId])
  @@index([provider, isActive])
  @@index([expiresAt])
  @@index([lastEventAt])
}

model WebhookDeadLetter {
  id              String @id @default(uuid())
  originalEventId String @unique

  // Original event data
  provider  Provider
  eventType WebhookEventType
  payload   Json
  headers   Json

  // Failure information
  failureReason String
  finalError    String?
  retryCount    Int

  // Metadata
  firstFailedAt DateTime
  lastRetryAt   DateTime
  resolvedAt    DateTime?
  resolvedBy    String? // Admin user who resolved
  archivedAt    DateTime? // soft archive — null = active

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider, eventType])
  @@index([firstFailedAt])
  @@index([resolvedAt])
}

// ─── Outbox Dead Letter (Sprint D) ──────────────────────────────────────────

model OutboxDeadLetter {
