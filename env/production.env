# Production Environment Variables
# Copy to secrets.env and replace placeholders with real values

NODE_ENV=production
API_PORT=3000
ADMIN_PORT=3100
CLIENT_PORT=3200

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
FEATURE_ANALYTICS=true
FEATURE_MULTI_TENANT=true
FEATURE_RATE_LIMITING=true

# Performance
NODE_OPTIONS=--max-old-space-size=512
UV_THREADPOOL_SIZE=16

# Database Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
