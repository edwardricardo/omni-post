# Secrets Environment Variables
# Copy to secrets.env and replace placeholders with real values
# NEVER COMMIT secrets.env TO VERSION CONTROL

# ═══════════════════════════════
# Database
# ═══════════════════════════════
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@postgres-service:5432/omnipostdb
POSTGRES_PASSWORD=YOUR_PASSWORD

# ═══════════════════════════════
# Redis
# ═══════════════════════════════
REDIS_URL=redis://:YOUR_PASSWORD@redis-service:6379
REDIS_PASSWORD=YOUR_PASSWORD

# ═══════════════════════════════
# JWT Authentication
# (generate with: openssl rand -hex 64)
# ═══════════════════════════════
JWT_SECRET=YOUR_64_CHAR_SECRET
JWT_ACCESS_SECRET=YOUR_64_CHAR_SECRET
JWT_REFRESH_SECRET=YOUR_64_CHAR_SECRET
ADMIN_JWT_ACCESS_SECRET=YOUR_64_CHAR_SECRET
ADMIN_JWT_REFRESH_SECRET=YOUR_64_CHAR_SECRET
COOKIE_SECRET=YOUR_64_CHAR_SECRET

# ═══════════════════════════════
# OAuth — X / Twitter
# ═══════════════════════════════
X_CLIENT_ID=YOUR_CLIENT_ID
X_CLIENT_SECRET=YOUR_CLIENT_SECRET
X_REDIRECT_URI=https://your-domain.com/auth/callback/x

# ═══════════════════════════════
# OAuth — Instagram
# ═══════════════════════════════
INSTAGRAM_CLIENT_ID=YOUR_CLIENT_ID
INSTAGRAM_CLIENT_SECRET=YOUR_CLIENT_SECRET
INSTAGRAM_REDIRECT_URI=https://your-domain.com/auth/callback/instagram
INSTAGRAM_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
INSTAGRAM_USER_ID=YOUR_USER_ID
INSTAGRAM_APP_ID=YOUR_APP_ID
INSTAGRAM_APP_SECRET=YOUR_APP_SECRET

# ═══════════════════════════════
# OAuth — Facebook
# ═══════════════════════════════
FACEBOOK_CLIENT_ID=YOUR_CLIENT_ID
FACEBOOK_CLIENT_SECRET=YOUR_CLIENT_SECRET
FACEBOOK_REDIRECT_URI=https://your-domain.com/auth/callback/facebook
FACEBOOK_ACCESS_TOKEN=YOUR_PAGE_ACCESS_TOKEN
FACEBOOK_PAGE_ID=YOUR_PAGE_ID
FACEBOOK_APP_ID=YOUR_APP_ID
FACEBOOK_APP_SECRET=YOUR_APP_SECRET
FACEBOOK_WEBHOOK_VERIFY_TOKEN=YOUR_WEBHOOK_VERIFY_TOKEN

# ═══════════════════════════════
# OAuth — YouTube / Google
# ═══════════════════════════════
YOUTUBE_CLIENT_ID=YOUR_CLIENT_ID
YOUTUBE_CLIENT_SECRET=YOUR_CLIENT_SECRET
YOUTUBE_REDIRECT_URI=https://your-domain.com/auth/callback/youtube
YOUTUBE_REFRESH_TOKEN=YOUR_REFRESH_TOKEN
YOUTUBE_CHANNEL_ID=YOUR_CHANNEL_ID

# ═══════════════════════════════
# OAuth — TikTok
# ═══════════════════════════════
TIKTOK_CLIENT_ID=YOUR_CLIENT_ID
TIKTOK_CLIENT_SECRET=YOUR_CLIENT_SECRET
TIKTOK_CLIENT_KEY=YOUR_CLIENT_KEY
TIKTOK_REDIRECT_URI=https://your-domain.com/auth/callback/tiktok
TIKTOK_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
TIKTOK_OPEN_ID=YOUR_OPEN_ID
TIKTOK_RESEARCH_API_KEY=YOUR_RESEARCH_API_KEY

# ═══════════════════════════════
# AWS / S3 Storage
# ═══════════════════════════════
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY

# ═══════════════════════════════
# AI Providers
# ═══════════════════════════════
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
