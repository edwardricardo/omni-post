{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "CI"],
  "globalDependencies": [
    "tsconfig.base.json",
    "tsconfig.build.base.json",
    "tsconfig.build.json",
    "tsconfig.json",
    ".env.example",
    "vitest.shared.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "NEXT_PUBLIC_*", "API_URL", "NEXT_TELEMETRY_DISABLED"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "//#typecheck:configs"],
      "outputs": []
    },
    "//#typecheck:configs": {
      "inputs": [
        "**/vitest*.config.ts",
        "tsconfig.vitest-configs.json",
        "packages/vitest-shared/src/**"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "REDIS_URL", "TEST_DATABASE_URL", "SHADOW_DATABASE_URL"],
      "passThroughEnv": ["VITEST_SHARDED"],
      "outputs": [],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "REDIS_URL", "TEST_DATABASE_URL", "SHADOW_DATABASE_URL"],
      "passThroughEnv": ["VITEST_SHARDED"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "env": ["DATABASE_URL", "REDIS_URL", "BASE_URL", "PLAYWRIGHT_*"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["@shared/types#build"],
      "cache": false,
      "persistent": true
    }
  }
}
